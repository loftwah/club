{
  "name": "social-club",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Plans With You — a paid membership relationship built on belonging, correspondence and intentional cancellation. See README.md, AGENTS.md, MASTER_SPEC.md and docs/.",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.23.0"
  },
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/clean-build-output.mjs && astro build",
    "perf:budget": "node scripts/performance/check-bundle-budget.mjs --dir dist/client",
    "test:performance": "node --test scripts/performance/check-bundle-budget.test.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "astro check && tsc --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:state": "vitest run tests/unit/state-machines",
    "wrangler:dev": "wrangler dev",
    "wrangler:deploy:dry": "wrangler deploy --dry-run --outdir=dist",
    "d1:migrate:local": "wrangler d1 migrations apply social-club --local",
    "d1:migrate:remote": "wrangler d1 migrations apply social-club --remote",
    "migrate:reset:local": "rm -rf .wrangler/state && pnpm d1:migrate:local",
    "acceptance": "node scripts/acceptance.mjs",
    "video:studio": "remotion studio video/index.ts --no-open",
    "video:status": "node scripts/video/status.mjs",
    "video:render": "node scripts/video/render.mjs",
    "video:render:all": "node scripts/video/render.mjs --all",
    "video:storyboard": "node scripts/video/storyboard.mjs --all",
    "video:qc": "node scripts/video/qc.mjs --all",
    "video:publish": "node --env-file=.env scripts/video/publish.mjs --all"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^14.2.3",
    "@astrojs/react": "^6.0.4",
    "@designcodeio/threeui": "0.3.0",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "@fontsource/fragment-mono": "5.3.0",
    "@lucide/astro": "1.33.0",
    "astro": "^7.2.4",
    "lucide-react": "1.33.0",
    "motion": "13.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^4.0.0",
    "svix": "^1.45.0",
    "typescript": "^5.6.0",
    "ulid": "^2.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "5.20260823.1",
    "@playwright/test": "^1.62.1",
    "@remotion/captions": "4.0.516",
    "@remotion/cli": "4.0.516",
    "@remotion/fonts": "4.0.516",
    "@remotion/layout-utils": "4.0.516",
    "@remotion/media": "4.0.516",
    "@remotion/motion-blur": "4.0.516",
    "@remotion/noise": "4.0.516",
    "@remotion/paths": "4.0.516",
    "@remotion/renderer": "4.0.516",
    "@remotion/shapes": "4.0.516",
    "@remotion/transitions": "4.0.516",
    "@remotion/zod-types": "4.0.516",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "eslint-plugin-astro": "^1.3.0",
    "playwright": "^1.62.1",
    "prettier": "^3.4.0",
    "prettier-plugin-astro": "^0.14.0",
    "remotion": "4.0.516",
    "tailwindcss": "4.3.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.125.0"
  }
}
