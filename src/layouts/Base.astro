---
// Base layout for all public-facing pages.
// Semantic HTML, accessible by default. No essential content depends on JS.
//
// ThreeUI is mounted as a small island in the hero; the hero degrades to
// semantic content when JS is unavailable or prefers-reduced-motion is set.
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
}

const {
  title = "The Social Club",
  description = "You belong. You are invited. You are remembered. You do not have to show up.",
  canonicalPath = "/",
} = Astro.props;

const baseUrl = Astro.locals?.runtime?.env.APP_BASE_URL ?? "https://club.loftwah.com";
const canonical = new URL(canonicalPath, baseUrl).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="robots" content="index,follow" />
    <meta name="theme-color" content="#0e1116" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to main content</a>
    <header class="site-header" role="banner">
      <div class="container">
        <a href="/" class="wordmark" aria-label="The Social Club — home">
          <span class="wordmark__text">The Social Club</span>
        </a>
        <nav aria-label="Primary">
          <ul>
            <li><a href="/membership/">Membership</a></li>
            <li><a href="/how-it-works/">How it works</a></li>
            <li><a href="/chapters/">Chapters</a></li>
            <li><a href="/journal/">Journal</a></li>
            <li><a href="/waiting-list/" class="cta-link">Waiting list</a></li>
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer" role="contentinfo">
      <div class="container">
        <p>
          The Social Club is a real paid membership. Ordinary events are deliberately cancelled. You
          are not expected to attend.
        </p>
        <p><a href="/privacy/">Privacy</a> &middot; <a href="/terms/">Terms</a></p>
      </div>
    </footer>
  </body>
</html>
