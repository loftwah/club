---
import { runtimeEnv } from "@lib/runtime-env";
// Base layout for public-facing pages. Essential navigation and content work
// without JavaScript; the native disclosure is the mobile navigation.
import "../styles/global.css";
import { ArrowUpRight } from "@lucide/astro";
import { brand } from "../brand/config";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogImagePath?: string;
}

const {
  title = brand.name,
  description = brand.seo.description,
  canonicalPath = "/",
  ogImagePath = "/og/default.svg",
} = Astro.props;

const baseUrl = runtimeEnv.APP_BASE_URL ?? "https://club.loftwah.com";
const canonical = new URL(canonicalPath, baseUrl).toString();
const ogImage = new URL(ogImagePath, baseUrl).toString();
const fullTitle = title === brand.name ? title : `${title} — ${brand.name}`;
const currentPath = Astro.url.pathname;

const navigation = [
  { href: "/how-it-works/", label: "How it works" },
  { href: "/membership/", label: "Membership" },
  { href: "/correspondence/", label: "In the post" },
  { href: "/chapters/", label: "Chapters" },
  { href: "/journal/", label: "Journal" },
];

const isCurrent = (href: string) => currentPath === href || currentPath.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="robots" content="index,follow" />
    <meta name="theme-color" content={brand.palette.bg} />
  </head>
  <body>
    <!--
      THESIS: A living operations desk for plans that are made, anticipated, and successfully unmade.
      OWN-WORLD: Contemporary schedule objects first; private correspondence provides warmth and tactility.
      STORY: Enter the schedule, watch a plan complete through cancellation, then discover the membership relationship that continues afterwards.
      FIRST VIEWPORT: Brand, date logic, cancellation-as-fulfilment, and a truthful waitlist action are legible without scrolling.
      FORM: Dispatch Wall — an administrative strip bay grounded by seed 2a9e769e, with disciplined grids, status typography, and vermilion interventions.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->
    <a href="#main" class="skip-link">Skip to main content</a>
    <header class="site-header" role="banner">
      <div class="site-header__signal" aria-label="Membership status">
        <div class="shell site-header__signal-inner">
          <span><span class="status-dot" aria-hidden="true"></span>Waitlist open</span>
          <span>Paid membership remains closed</span>
        </div>
      </div>
      <div class="shell site-header__main">
        <a href="/" class="wordmark" aria-label={`${brand.name} — home`}>
          <span class="wordmark__calendar" aria-hidden="true"><span>PWY</span><b>24</b></span>
          <span class="wordmark__text">Plans<br />With You</span>
        </a>

        <nav class="desktop-nav" aria-label="Primary">
          <ul>
            {
              navigation.map((item) => (
                <li>
                  <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <a href="/waiting-list/" class="header-cta">
          Join the waitlist <ArrowUpRight size={14} stroke-width={1.8} aria-hidden="true" />
        </a>

        <details class="mobile-nav">
          <summary
            ><span>Menu</span><span class="mobile-nav__icon" aria-hidden="true"></span></summary
          >
          <nav aria-label="Mobile primary">
            <ul>
              {
                navigation.map((item) => (
                  <li>
                    <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
                      {item.label}
                    </a>
                  </li>
                ))
              }
              <li><a href="/faq/">Questions</a></li>
              <li><a href="/waiting-list/">Join the waitlist</a></li>
            </ul>
          </nav>
        </details>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer" role="contentinfo">
      <div class="shell site-footer__grid">
        <div class="site-footer__statement">
          <p>You are wanted.<br />You don’t have to go.</p>
        </div>
        <div>
          <p class="site-footer__label">The arrangement</p>
          <p>
            Ordinary plans are deliberately constructed, then deliberately cancelled. Cancellation
            is successful fulfilment. Silence is a valid way to belong.
          </p>
        </div>
        <nav aria-label="Footer">
          <p class="site-footer__label">Small print</p>
          <ul>
            <li><a href="/privacy/">Privacy</a></li>
            <li><a href="/terms/">Terms</a></li>
            <li><a href="/faq/">Questions</a></li>
            <li><a href="/portal/login/">Member portal</a></li>
          </ul>
        </nav>
      </div>
      <div class="shell site-footer__base">
        <span>Melbourne, Australia</span><span>© {new Date().getFullYear()} {brand.name}</span>
      </div>
    </footer>
    <script is:inline>
      const mobileNavigation = document.querySelector("details.mobile-nav");
      const pageMain = document.querySelector("body > main");
      const pageFooter = document.querySelector("body > footer");
      if (mobileNavigation instanceof HTMLDetailsElement) {
        const summary = mobileNavigation.querySelector("summary");
        const synchroniseMenu = () => {
          const open = mobileNavigation.open;
          document.documentElement.classList.toggle("mobile-menu-open", open);
          if (pageMain instanceof HTMLElement) pageMain.inert = open;
          if (pageFooter instanceof HTMLElement) pageFooter.inert = open;
        };
        mobileNavigation.addEventListener("toggle", synchroniseMenu);
        mobileNavigation.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", () => {
            mobileNavigation.open = false;
          });
        });
        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && mobileNavigation.open) {
            mobileNavigation.open = false;
            if (summary instanceof HTMLElement) summary.focus();
          }
        });
        synchroniseMenu();
      }
    </script>
  </body>
</html>
