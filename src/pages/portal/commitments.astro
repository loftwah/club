---
import { runtimeEnv } from "@lib/runtime-env";
import Base from "@layouts/Base.astro";
import "../../styles/app-surfaces.css";
import { requireSession } from "../../lib/portal-auth";

const ctx = await requireSession(Astro.request, runtimeEnv);
if (!ctx) return Astro.redirect("/portal/login/");

const env = runtimeEnv;

const existing = (
  await env.DB.prepare(
    `SELECT id, goal, scenario_text, state, confirmed_at, completed_at, created_at
       FROM commitment_scenarios
       WHERE member_id = ?
       ORDER BY created_at DESC
       LIMIT 10`,
  )
    .bind(ctx.member.id)
    .all<{
      id: string;
      goal: string | null;
      scenario_text: string | null;
      state: string;
      confirmed_at: string | null;
      completed_at: string | null;
      created_at: string;
    }>()
).results;
---

<Base
  title="Manufactured commitments"
  description="Consensual artificial social obligations. We can construct a plausible visitor."
  canonicalPath="/portal/commitments/"
>
  <section class="section app-surface">
    <div class="container">
      <header class="app-page-head">
        <div class="app-page-head__main">
          <p class="app-breadcrumb"><a href="/portal/">Portal</a> / Commitments</p>
          <p class="app-kicker">Optional pressure, explicitly bounded</p>
          <h1>Manufactured commitments</h1>
          <p class="app-lede">
            A consensual artificial social obligation can create useful pressure around a goal, then
            close cleanly. The fictional visitor never really travelled.
          </p>
        </div>
        <dl class="app-page-head__aside">
          <dt>Control</dt><dd>You can abort at any time</dd><dt>Terminal outcome</dt><dd>
            Completed or explicitly aborted
          </dd>
        </dl>
      </header>

      <section class="app-section" aria-labelledby="request-heading">
        <div class="app-section__head">
          <h2 id="request-heading">Request a new one</h2><p>Starts with your consent</p>
        </div>
        <div class="app-callout app-callout--calm">
          <strong>Nothing dangles.</strong> Once you abort, the fictional visitor is cancelled and future
          reminders are cleared.
        </div>
        <form class="form app-form" method="post" action="/api/portal/commitments/request">
          <div class="app-form__grid">
            <div class="app-form__field app-form__field--full">
              <label for="goal">Your goal</label><input
                id="goal"
                name="goal"
                type="text"
                required
                maxlength="200"
                placeholder="Clean the apartment before Friday"
              />
            </div>
            <div class="app-form__field app-form__field--full">
              <label for="scenario">Your proposed scenario (optional)</label><textarea
                id="scenario"
                name="scenario"
                rows="3"
                maxlength="600"
                placeholder="A friend from out of town is visiting on Saturday and will need a clean apartment. You will be ready."
              ></textarea><p class="app-form__hint">
                The scenario remains fictional and should not impersonate a real person or
                authority.
              </p>
            </div>
          </div>
          <div class="app-form__actions">
            <button class="app-action" type="submit"
              >Request a commitment <span aria-hidden="true">→</span></button
            >
          </div>
        </form>
      </section>

      <section class="app-section" aria-labelledby="history-heading">
        <div class="app-section__head">
          <h2 id="history-heading">Active and past</h2><p>{existing.length} recorded</p>
        </div>
        {
          existing.length === 0 ? (
            <p class="app-empty">
              <>
                <strong>No commitments yet</strong>
                <span>
                  Any request you make will appear here with its current terminal or in-progress
                  state.
                </span>
              </>
            </p>
          ) : (
            <ul class="app-list">
              {existing.map((c) => (
                <li>
                  <span class="app-list__label">{c.created_at.slice(0, 10)}</span>
                  <span class="app-list__detail">
                    <strong>{c.goal ?? "(no goal)"}</strong>
                    {c.scenario_text ? (
                      <>
                        <br />
                        <span class="app-note">Scenario: {c.scenario_text}</span>
                      </>
                    ) : null}
                    <br />
                    <span class="app-provenance">
                      {c.confirmed_at
                        ? `Confirmed ${c.confirmed_at.slice(0, 10)}`
                        : "Awaiting confirmation"}
                      {c.completed_at ? ` · closed ${c.completed_at.slice(0, 10)}` : ""}
                    </span>
                  </span>
                  {c.state !== "COMPLETED" && c.state !== "ABORTED" && c.state !== "DECLINED" ? (
                    <form method="post" action="/api/portal/commitments/abort">
                      <input type="hidden" name="id" value={c.id} />
                      <button type="submit" class="app-action app-action--danger">
                        Abort
                      </button>
                    </form>
                  ) : (
                    <span class={`pill ${c.state === "COMPLETED" ? "pill--ok" : "pill--warn"}`}>
                      {c.state}
                    </span>
                  )}
                </li>
              ))}
            </ul>
          )
        }
      </section>
    </div>
  </section>
</Base>
