---
import { runtimeEnv } from "@lib/runtime-env";
import Base from "@layouts/Base.astro";
import "../../styles/app-surfaces.css";
import { requireSession } from "../../lib/portal-auth";
import { MemberMemoryService } from "@services/member-memory";
import { SystemClock } from "@infra/clock";
import { D1AuditWriter } from "@infra/audit";

const ctx = await requireSession(Astro.request, runtimeEnv);
if (!ctx) return Astro.redirect("/portal/login/");

const env = runtimeEnv;
const audit = new D1AuditWriter(env.DB, new SystemClock());
const clock = new SystemClock();
const memory = new MemberMemoryService({ db: env.DB, audit, clock });
const all = await memory.listForMember(ctx.member.id);
const usable = await memory.usableForMember(ctx.member.id);
const candidates = all.filter((f) => f.status === "CANDIDATE");
const revoked = all.filter((f) => f.status === "REVOKED" || f.status === "REJECTED");
---

<Base
  title="What we remember about you"
  description="Manage your member memory."
  canonicalPath="/portal/memory/"
>
  <section class="section app-surface">
    <div class="container">
      <header class="app-page-head">
        <div class="app-page-head__main">
          <p class="app-breadcrumb"><a href="/portal/">Portal</a> / Memory</p>
          <p class="app-kicker">Member-controlled record</p>
          <h1>What we remember about you</h1>
          <p class="app-lede">
            We remember only what you choose to share. Every fact has a visible state and
            provenance; AI may propose candidates, but only you can confirm.
          </p>
        </div>
        <dl class="app-page-head__aside">
          <dt>Available to mention</dt><dd>
            {usable.length} confirmed fact{usable.length === 1 ? "" : "s"}
          </dd><dt>Pending review</dt><dd>
            {candidates.length} candidate{candidates.length === 1 ? "" : "s"}
          </dd>
        </dl>
      </header>

      <section class="app-section" aria-labelledby="confirmed-heading">
        <div class="app-section__head">
          <h2 id="confirmed-heading">Confirmed facts we can mention</h2><p>
            {usable.length} available
          </p>
        </div>
        {
          usable.length === 0 ? (
            <p class="app-empty">
              <>
                <strong>No confirmed facts yet</strong>
                <span>Nothing will be used in correspondence until you confirm it.</span>
              </>
            </p>
          ) : (
            <ul class="app-list">
              {usable.map((f) => (
                <li>
                  <span class="app-list__label">{f.category}</span>
                  <span class="app-list__detail">
                    <strong>{f.subject}</strong> · {JSON.stringify(f.value)}
                    <br />
                    <span class="app-provenance">Source: {f.sourceType ?? "self"}</span>
                  </span>
                  <span class="app-actions">
                    <form method="post" action="/api/portal/memory/do-not-use">
                      <input type="hidden" name="factId" value={f.id} />
                      <input type="hidden" name="next" value="1" />
                      <button type="submit" class="app-action app-action--quiet">
                        Do not mention
                      </button>
                    </form>
                    <form method="post" action="/api/portal/memory/revoke">
                      <input type="hidden" name="factId" value={f.id} />
                      <button type="submit" class="app-action app-action--danger">
                        Revoke
                      </button>
                    </form>
                  </span>
                </li>
              ))}
            </ul>
          )
        }
      </section>

      <section class="app-section" aria-labelledby="candidate-heading">
        <div class="app-section__head">
          <h2 id="candidate-heading">Pending candidates</h2><p>
            {candidates.length} awaiting your decision
          </p>
        </div>
        {
          candidates.length === 0 ? (
            <p class="app-empty">
              <>
                <strong>No pending candidates</strong>
                <span>When a candidate is proposed, it will wait here for your decision.</span>
              </>
            </p>
          ) : (
            <ul class="app-list">
              {candidates.map((f) => (
                <li>
                  <span class="app-list__label">{f.category}</span>
                  <span class="app-list__detail">
                    <strong>{f.subject}</strong> · {JSON.stringify(f.value)}
                    <br />
                    <span class="app-provenance">Proposed from: {f.sourceType ?? "self"}</span>
                  </span>
                  <span class="app-actions">
                    <form method="post" action="/api/portal/memory/confirm">
                      <input type="hidden" name="factId" value={f.id} />
                      <button type="submit" class="app-action">
                        Confirm
                      </button>
                    </form>
                    <form method="post" action="/api/portal/memory/reject">
                      <input type="hidden" name="factId" value={f.id} />
                      <button type="submit" class="app-action app-action--danger">
                        Reject
                      </button>
                    </form>
                  </span>
                </li>
              ))}
            </ul>
          )
        }
      </section>

      <section class="app-section" aria-labelledby="restricted-heading">
        <div class="app-section__head">
          <h2 id="restricted-heading">Restricted and revoked</h2><p>Not available to mention</p>
        </div>
        {
          revoked.length === 0 ? (
            <p class="app-empty">
              <>
                <strong>No restricted facts</strong>
                <span>
                  Facts you revoke or mark do-not-mention will remain visible here as a transparent
                  record.
                </span>
              </>
            </p>
          ) : (
            <ul class="app-list">
              {revoked.map((f) => (
                <li>
                  <span class="app-list__label">{f.category}</span>
                  <span class="app-list__detail">
                    {f.subject}
                    <br />
                    <span class="app-provenance">
                      State: {f.status}
                      {f.doNotUse ? " · do-not-mention" : ""}
                    </span>
                  </span>
                  <span class="pill pill--warn">restricted</span>
                </li>
              ))}
            </ul>
          )
        }
      </section>

      <section class="app-section" aria-labelledby="add-heading">
        <div class="app-section__head">
          <h2 id="add-heading">Add a fact</h2><p>Optional and editable</p>
        </div>
        <p class="app-note">
          A fact might be a pet, a hobby, a project, or an important date. You can change or remove
          it at any time. It is never shared or used to train models.
        </p>
        <form class="form app-form" method="post" action="/api/portal/memory/add">
          <div class="app-form__grid">
            <div class="app-form__field">
              <label for="category">Category</label><input
                id="category"
                name="category"
                type="text"
                required
                maxlength="60"
                placeholder="interest, pet, project, important date"
              />
            </div>
            <div class="app-form__field">
              <label for="subject">Subject</label><input
                id="subject"
                name="subject"
                type="text"
                required
                maxlength="120"
              />
            </div>
            <div class="app-form__field app-form__field--full">
              <label for="value">Value</label><input
                id="value"
                name="value"
                type="text"
                required
                maxlength="200"
              />
            </div>
          </div>
          <div class="app-form__actions">
            <button class="app-action" type="submit"
              >Save fact <span aria-hidden="true">→</span></button
            >
          </div>
        </form>
      </section>
    </div>
  </section>
</Base>
