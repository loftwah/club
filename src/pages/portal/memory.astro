---
import Base from "@layouts/Base.astro";
import { requireSession } from "../../lib/portal-auth";
import { MemberMemoryService } from "@services/member-memory";
import { SystemClock } from "@infra/clock";
import { D1AuditWriter } from "@infra/audit";

const ctx = await requireSession(Astro.request, Astro.locals?.runtime?.env);
if (!ctx) return Astro.redirect("/portal/login/");

const env = Astro.locals.runtime.env;
const audit = new D1AuditWriter(env.DB, new SystemClock());
const clock = new SystemClock();
const memory = new MemberMemoryService({ db: env.DB, audit, clock });
const all = await memory.listForMember(ctx.member.id);
const usable = await memory.usableForMember(ctx.member.id);
const candidates = all.filter((f) => f.status === "CANDIDATE");
const revoked = all.filter((f) => f.status === "REVOKED" || f.status === "REJECTED");
---

<Base
  title="What the Society remembers about you"
  description="Manage your member memory."
  canonicalPath="/portal/memory/"
>
  <section class="section">
    <div class="container">
      <p style="color: var(--fg-faint)">
        <a href="/portal/">Portal</a> / Memory
      </p>
      <h1>What the Society remembers about you</h1>
      <p>
        The Society remembers only what you choose to share. You can edit, remove, mark as
        do-not-mention, or add new information. AI may propose candidates; only you can confirm.
      </p>

      <h2>Confirmed facts the Society can mention ({usable.length})</h2>
      {
        usable.length === 0 ? (
          <p style="color: var(--fg-muted)">No confirmed facts yet.</p>
        ) : (
          <ul>
            {usable.map((f) => (
              <li>
                <strong>{f.category}</strong>: {f.subject}
                <span style="color: var(--fg-faint)"> · {JSON.stringify(f.value)}</span>
                <form method="post" action="/api/portal/memory/do-not-use" style="display: inline;">
                  <input type="hidden" name="factId" value={f.id} />
                  <input type="hidden" name="next" value="1" />
                  <button type="submit" class="link-button">
                    Mark as do-not-mention
                  </button>
                </form>
                <form method="post" action="/api/portal/memory/revoke" style="display: inline;">
                  <input type="hidden" name="factId" value={f.id} />
                  <button type="submit" class="link-button link-button--danger">
                    Revoke (forget)
                  </button>
                </form>
              </li>
            ))}
          </ul>
        )
      }

      <h2>Pending candidates ({candidates.length})</h2>
      {
        candidates.length === 0 ? (
          <p style="color: var(--fg-muted)">No pending candidates.</p>
        ) : (
          <ul>
            {candidates.map((f) => (
              <li>
                <strong>{f.category}</strong>: {f.subject}
                <span style="color: var(--fg-faint)"> · source: {f.sourceType ?? "self"}</span>
                <form method="post" action="/api/portal/memory/confirm" style="display: inline;">
                  <input type="hidden" name="factId" value={f.id} />
                  <button type="submit" class="link-button">
                    Confirm
                  </button>
                </form>
                <form method="post" action="/api/portal/memory/reject" style="display: inline;">
                  <input type="hidden" name="factId" value={f.id} />
                  <button type="submit" class="link-button link-button--danger">
                    Reject
                  </button>
                </form>
              </li>
            ))}
          </ul>
        )
      }

      <h2>Do-not-mention or revoked</h2>
      {
        revoked.length === 0 ? (
          <p style="color: var(--fg-muted)">No revoked or do-not-mention facts.</p>
        ) : (
          <ul>
            {revoked.map((f) => (
              <li style="color: var(--fg-faint)">
                <strong>{f.category}</strong>: {f.subject} — {f.status}
                {f.doNotUse ? " (also do-not-use)" : ""}
              </li>
            ))}
          </ul>
        )
      }

      <h2>Add a fact</h2>
      <p>
        The Society may use this in future correspondence. You can change or remove it at any time.
      </p>
      <form class="form" method="post" action="/api/portal/memory/add">
        <label for="category">Category</label>
        <input
          id="category"
          name="category"
          type="text"
          required
          maxlength="60"
          placeholder="interest, pet, project, important date"
        />
        <label for="subject">Subject</label>
        <input id="subject" name="subject" type="text" required maxlength="120" />
        <label for="value">Value</label>
        <input id="value" name="value" type="text" required maxlength="200" />
        <button type="submit">Save fact</button>
      </form>

      <h2>What is a fact?</h2>
      <p style="color: var(--fg-muted)">
        A fact is a small piece of information about you — a pet, a hobby, a project, an important
        date. The Society may use it to personalise correspondence. It is never shared or used to
        train models. You may revoke or remove any fact at any time.
      </p>
    </div>
  </section>
</Base>
