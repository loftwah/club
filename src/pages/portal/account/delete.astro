---
import Base from "@layouts/Base.astro";
import { requireSession } from "../../../lib/portal-auth";

const ctx = await requireSession(Astro.request, Astro.locals?.runtime?.env);
if (!ctx) return Astro.redirect("/portal/login/");
---

<Base
  title="Account deletion"
  description="Stop future personalisation and request data removal."
  canonicalPath="/portal/account/delete/"
>
  <section class="section">
    <div class="container">
      <p style="color: var(--fg-faint)">
        <a href="/portal/">Portal</a> / Account / Delete
      </p>
      <h1>Account deletion</h1>
      <p>
        Account deletion stops future personalisation and triggers the data-removal workflow.
        Required records (e.g. financial records) are kept for the minimum period required by law
        and then removed.
      </p>
      <p style="color: var(--fg-muted)">
        <strong>You can re-join at any time.</strong> The waiting list is always open.
      </p>
      <form class="form" method="post" action="/api/portal/account/delete">
        <label for="confirm">
          <input id="confirm" type="checkbox" name="confirm" value="true" required />
          I understand my membership will end, my memory and timeline will be removed, and the Society
          will email me a confirmation link to verify the request.
        </label>
        <button type="submit">Request account deletion</button>
      </form>
      <p>
        <a href="/portal/">Cancel and return to portal</a>
      </p>
    </div>
  </section>
</Base>
