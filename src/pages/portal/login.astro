---
import Base from "@layouts/Base.astro";
import "../../styles/app-surfaces.css";
---

<Base
  title="Sign in"
  description="Sign in to the member portal. We use magic links, not passwords."
  canonicalPath="/portal/login/"
>
  <section class="section app-surface app-login">
    <div class="container">
      <div class="app-card">
        <p class="app-breadcrumb"><a href="/">Plans With You</a> / Member portal</p>
        <p class="app-kicker">Private correspondence desk</p>
        <h1>Sign in</h1>
        <p class="app-lede">
          We use <strong>magic links</strong>, not passwords. Enter the email address on your
          membership and we will send a one-time link. It expires in 15 minutes.
        </p>
        <form class="form app-form" id="login-form" novalidate aria-describedby="login-status">
          <div class="app-form__field">
            <label for="email">Email address</label>
            <input
              id="email"
              name="email"
              type="email"
              required
              autocomplete="email"
              inputmode="email"
              placeholder="you@example.com"
            />
          </div>
          <div class="app-form__actions">
            <button class="app-action" type="submit" id="login-submit"
              >Send me a sign-in link <span aria-hidden="true">→</span></button
            >
          </div>
          <p id="login-status" class="form__status" role="status" aria-live="polite"></p>
        </form>
        <p class="app-note">
          Not on the list? <a href="/waiting-list/">Add your name to the global waitlist</a>.
        </p>
      </div>
    </div>
  </section>
</Base>

<script>
  const form = document.getElementById("login-form") as HTMLFormElement | null;
  const status = document.getElementById("login-status") as HTMLElement | null;
  const submit = document.getElementById("login-submit") as HTMLButtonElement | null;
  if (form && status && submit) {
    form.addEventListener("submit", async (ev) => {
      ev.preventDefault();
      status.className = "form__status";
      status.textContent = "Sending sign-in link…";
      submit.disabled = true;
      const data = new FormData(form);
      const email = String(data.get("email") ?? "").trim();
      const next = new URLSearchParams(window.location.search).get("next");
      if (!email) {
        status.className = "form__status form__status--error";
        status.textContent = "Enter your email address.";
        submit.disabled = false;
        return;
      }
      try {
        const res = await fetch("/api/portal/login", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ email, next }),
        });
        const body = (await res.json().catch(() => ({}))) as { error?: string; devUrl?: string };
        if (!res.ok) {
          status.className = "form__status form__status--error";
          status.textContent = body.error ?? `Request failed (${res.status})`;
          submit.disabled = false;
          return;
        }
        status.className = "form__status form__status--success";
        status.textContent =
          "If the email is on a member record, a sign-in link is on its way. Check your inbox.";
        if (body.devUrl) {
          // Local dev convenience: surface the magic link so the
          // developer can use it without setting up Resend.
          const a = document.createElement("a");
          a.href = body.devUrl;
          a.textContent = "Open the link (dev only)";
          a.style.display = "block";
          a.style.marginTop = "0.5rem";
          a.style.color = "var(--accent)";
          a.style.textDecoration = "underline";
          status.appendChild(a);
        }
        form.reset();
        submit.disabled = false;
      } catch {
        status.className = "form__status form__status--error";
        status.textContent = "Network error. Please try again.";
        submit.disabled = false;
      }
    });
  }
</script>
