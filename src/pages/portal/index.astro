---
import { runtimeEnv } from "@lib/runtime-env";
// Real member portal home.
// Member sees: membership status, tier, member number, chapter,
// join date, tenure, current/upcoming plans, correspondence
// history, milestone history, artefacts/gifts.
import Base from "@layouts/Base.astro";
import "../../styles/app-surfaces.css";
import { requireSession } from "../../lib/portal-auth";
import { MemberMemoryService } from "@services/member-memory";
import { SystemClock } from "@infra/clock";
import { D1AuditWriter } from "@infra/audit";

const ctx = await requireSession(Astro.request, runtimeEnv);
if (!ctx) {
  return Astro.redirect("/portal/login/");
}

const env = runtimeEnv;
const audit = new D1AuditWriter(env.DB, new SystemClock());
const clock = new SystemClock();
const memory = new MemberMemoryService({ db: env.DB, audit, clock });

const member = ctx.member;
const membershipRow = await env.DB.prepare(
  `SELECT m.state, m.started_at, m.tier_id, t.display_name AS tier_name, t.price_cents
       FROM memberships m
       LEFT JOIN membership_tiers t ON t.id = m.tier_id
       WHERE m.member_id = ?`,
)
  .bind(member.id)
  .first<{
    state: string;
    started_at: string | null;
    tier_id: string | null;
    tier_name: string | null;
    price_cents: number | null;
  }>();

const chapter = member.chapterId
  ? await env.DB.prepare(`SELECT name FROM chapters WHERE id = ?`)
      .bind(member.chapterId)
      .first<{ name: string }>()
  : null;

const memberNumber = `PW-${member.id.slice(-6).toUpperCase()}`;
const tenureMonths = membershipRow?.started_at
  ? Math.floor(
      (new Date(clock.nowIso()).getTime() - new Date(membershipRow.started_at).getTime()) /
        (30.44 * 24 * 3600 * 1000),
    )
  : 0;

// Current/upcoming fictional engagements.
const upcoming = await env.DB.prepare(
  `SELECT id, title, start_at, state FROM events
       WHERE chapter_id = ?
         AND state IN ('SCHEDULED', 'INVITATIONS_QUEUED', 'INVITED', 'REMINDER_WINDOW')
         AND start_at > ?
       ORDER BY start_at ASC
       LIMIT 5`,
)
  .bind(member.chapterId, clock.nowIso())
  .all<{ id: string; title: string; start_at: string; state: string }>();

const recentCancellations = await env.DB.prepare(
  `SELECT id, title, cancelled_at FROM events
       WHERE chapter_id = ?
         AND state IN ('CANCELLED', 'ARCHIVED')
         AND cancelled_at > ?
       ORDER BY cancelled_at DESC
       LIMIT 5`,
)
  .bind(member.chapterId, new Date(Date.now() - 90 * 24 * 3600 * 1000).toISOString())
  .all<{ id: string; title: string; cancelled_at: string | null }>();

const correspondence = await env.DB.prepare(
  `SELECT id, template_key, state, sent_at, related_entity_type FROM communications
       WHERE member_id = ?
       ORDER BY created_at DESC LIMIT 10`,
)
  .bind(member.id)
  .all<{
    id: string;
    template_key: string;
    state: string;
    sent_at: string | null;
    related_entity_type: string | null;
  }>();

const milestones = await env.DB.prepare(
  `SELECT id, trigger_type, triggered_on FROM member_milestones
       WHERE member_id = ?
       ORDER BY triggered_on DESC LIMIT 10`,
)
  .bind(member.id)
  .all<{ id: string; trigger_type: string; triggered_on: string }>();

const memoryFacts = await memory.listForMember(member.id);
const usableFacts = await memory.usableForMember(member.id);

const grants = await env.DB.prepare(`SELECT service, state FROM service_grants WHERE member_id = ?`)
  .bind(member.id)
  .all<{ service: string; state: string }>();
const grantMap = new Map(grants.results?.map((g) => [g.service, g.state]) ?? []);
---

<Base title="Member portal" description="Your membership at a glance." canonicalPath="/portal/">
  <section class="section app-surface">
    <div class="container">
      <header class="app-page-head">
        <div class="app-page-head__main">
          <p class="app-breadcrumb"><a href="/portal/">Portal</a> / Home</p>
          <p class="app-kicker">Private membership record</p>
          <h1>Hello, {member.preferredName ?? "member"}</h1>
          <p class="app-lede">
            Your place here does not depend on replying, attending, or checking in. This is the
            record of what has been made, sent, remembered, and cared for.
          </p>
        </div>
        <dl class="app-page-head__aside">
          <dt>Member number</dt>
          <dd>{memberNumber}</dd>
          <dt>Record status</dt>
          <dd>{membershipRow?.state ?? "Not yet recorded"}</dd>
        </dl>
      </header>

      <section class="app-section" aria-labelledby="membership-heading">
        <div class="app-section__head">
          <h2 id="membership-heading">Your membership</h2>
          <p>At a glance</p>
        </div>
        <div class="app-summary-grid">
          <article class="app-card app-card--accent">
            <p class="app-kicker">Current state</p>
            <h3>{membershipRow?.state ?? "Not yet recorded"}</h3>
            <p class="app-card__note">
              Your membership is not a performance contract. Silence is a valid way to belong.
            </p>
          </article>
          <article class="app-card">
            <h3>{membershipRow?.tier_name ?? "Tier not recorded"}</h3>
            <p class="app-card__note">
              {
                membershipRow?.price_cents
                  ? `A$${(membershipRow.price_cents / 100).toFixed(0)} / month`
                  : "Pricing not recorded"
              }
            </p>
            <dl class="app-stat-grid">
              <div><dt>Chapter</dt><dd>{chapter?.name ?? "Not assigned"}</dd></div>
              <div><dt>Joined</dt><dd>{membershipRow?.started_at?.slice(0, 10) ?? "—"}</dd></div>
              <div><dt>Tenure</dt><dd>{tenureMonths > 0 ? `${tenureMonths} months` : "—"}</dd></div>
              <div><dt>Timezone</dt><dd>{member.timezone ?? "—"}</dd></div>
            </dl>
          </article>
        </div>
      </section>

      <section class="app-section" aria-labelledby="plans-heading">
        <div class="app-section__head">
          <h2 id="plans-heading">Plans in preparation</h2>
          <p>Constructed with care</p>
        </div>
        <p class="app-note">
          Ordinary plans are made, anticipated, and deliberately cancelled. Cancellation is
          successful fulfilment; there is nothing you need to attend.
        </p>
        {
          upcoming.results?.length === 0 ? (
            <p class="app-empty">
              <>
                <strong>Nothing currently in preparation</strong>
                <span>
                  New plans will arrive in your correspondence when there is something to share.
                </span>
              </>
            </p>
          ) : (
            <div class="app-table-wrap">
              <table class="admin-table app-table app-table--cards">
                <thead>
                  <tr>
                    <>
                      <th>State</th>
                      <th>Plan</th>
                      <th>Scheduled date</th>
                    </>
                  </tr>
                </thead>
                <tbody>
                  {upcoming.results?.map((e) => (
                    <tr>
                      <td data-label="State">
                        <span class="pill pill--info">{e.state}</span>
                      </td>
                      <td data-label="Plan">{e.title}</td>
                      <td data-label="Scheduled date">
                        {e.start_at.slice(0, 16).replace("T", " ")}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )
        }
      </section>

      <section class="app-section" aria-labelledby="history-heading">
        <div class="app-section__head">
          <h2 id="history-heading">Plan history</h2>
          <p>Recently completed</p>
        </div>
        {
          recentCancellations.results?.length === 0 ? (
            <p class="app-empty">
              <>
                <strong>No completed cancellations yet</strong>
                <span>Your history will accumulate here as plans are successfully unmade.</span>
              </>
            </p>
          ) : (
            <div class="app-table-wrap">
              <table class="admin-table app-table app-table--cards">
                <thead>
                  <tr>
                    <>
                      <th>Plan</th>
                      <th>Completed on</th>
                    </>
                  </tr>
                </thead>
                <tbody>
                  {recentCancellations.results?.map((e) => (
                    <tr>
                      <td data-label="Plan">{e.title}</td>
                      <td data-label="Completed on">{e.cancelled_at?.slice(0, 10) ?? "—"}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )
        }
      </section>

      <section class="app-section" aria-labelledby="milestones-heading">
        <div class="app-section__head">
          <h2 id="milestones-heading">Milestones</h2><p>Accumulated history</p>
        </div>
        {
          milestones.results?.length === 0 ? (
            <p class="app-empty">
              <>
                <strong>No milestones yet</strong>
                <span>Milestones will appear here as your membership record grows.</span>
              </>
            </p>
          ) : (
            <ul class="app-list">
              {milestones.results?.map((m) => (
                <li>
                  <span class="app-list__label">{m.triggered_on}</span>
                  <span class="app-list__detail">{m.trigger_type.replaceAll("_", " ")}</span>
                  <span class="pill pill--ok">recorded</span>
                </li>
              ))}
            </ul>
          )
        }
      </section>

      <section class="app-section" aria-labelledby="correspondence-heading">
        <div class="app-section__head">
          <h2 id="correspondence-heading">Correspondence</h2>
          <p>What has been sent</p>
        </div>
        {
          correspondence.results?.length === 0 ? (
            <p class="app-empty">
              <>
                <strong>No correspondence yet</strong>
                <span>Your first letter or message will appear here with its delivery state.</span>
              </>
            </p>
          ) : (
            <div class="app-table-wrap">
              <table class="admin-table app-table app-table--cards">
                <thead>
                  <tr>
                    <>
                      <th>Type</th>
                      <th>State</th>
                      <th>Sent</th>
                    </>
                  </tr>
                </thead>
                <tbody>
                  {correspondence.results?.map((c) => (
                    <tr>
                      <td data-label="Type">{c.template_key}</td>
                      <td data-label="State">
                        <span class="pill pill--info">{c.state}</span>
                      </td>
                      <td data-label="Sent">{c.sent_at?.slice(0, 10) ?? "queued"}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )
        }
      </section>

      <section class="app-section" aria-labelledby="memory-heading">
        <div class="app-section__head">
          <h2 id="memory-heading">Your memory record</h2>
          <p>{memoryFacts.length} recorded</p>
        </div>
        <div class="app-card-grid">
          <article class="app-card app-card--wide app-card--accent">
            <h3>
              {
                usableFacts.length === 0
                  ? "Nothing confirmed yet"
                  : `${usableFacts.length} fact${usableFacts.length === 1 ? "" : "s"} available to mention`
              }
            </h3>
            <p>
              Only confirmed facts can be used in future correspondence. Every item has a source and
              a state you control.
            </p>
            <a class="app-action app-action--quiet" href="/portal/memory"
              >Inspect memory, provenance, and restrictions <span aria-hidden="true">→</span></a
            >
          </article>
          <article class="app-card">
            <p class="app-kicker">Member-controlled</p>
            <h3>Choose what continues</h3>
            <p class="app-card__note">
              Confirm, reject, revoke, or mark an item do-not-mention at any time.
            </p>
          </article>
        </div>
      </section>

      <section class="app-section" aria-labelledby="services-heading">
        <div class="app-section__head">
          <h2 id="services-heading">Optional services</h2>
          <p>Permission by permission</p>
        </div>
        <p class="app-note">
          Each service is independently consented. Revoking one does not change your core membership
          or other permissions.
        </p>
        <ul class="app-list">
          {
            [
              { key: "NEWSLETTER", label: "Newsletter" },
              { key: "PERSONALISED_MEMORY", label: "Personalised memory" },
              { key: "CALENDAR_MESSAGES", label: "Calendar messages" },
              { key: "PHYSICAL_CORRESPONDENCE", label: "Physical correspondence" },
              { key: "GIFTS", label: "Gifts" },
              { key: "CALLS", label: "Calls" },
              { key: "MANUFACTURED_COMMITMENTS", label: "Manufactured commitments" },
              { key: "APPEARANCE_INTEREST", label: "Appearance service interest" },
            ].map(({ key: svc, label }) => {
              const state = grantMap.get(svc) ?? "AVAILABLE";
              return (
                <li>
                  <>
                    <span class="app-list__label">{label}</span>
                    <span class="app-list__detail">{state}</span>
                    <span
                      class={`pill pill--${state === "OPTED_IN" ? "ok" : state === "OPTED_OUT" ? "warn" : "info"}`}
                    >
                      {state}
                    </span>
                  </>
                </li>
              );
            })
          }
        </ul>
        <div class="app-actions" style="margin-top: 1rem;">
          <a class="app-action app-action--quiet" href="/portal/preferences"
            >Manage preferences and permissions <span aria-hidden="true">→</span></a
          >
        </div>
      </section>

      <section class="app-section" aria-labelledby="more-heading">
        <div class="app-section__head">
          <h2 id="more-heading">More ways we can help</h2><p>Always optional</p>
        </div>
        <div class="app-link-grid">
          <li>
            <a href="/portal/commitments"
              >Manufactured commitments <span aria-hidden="true">→</span></a
            >
          </li>
          <li>
            <a href="/portal/appearance">Appearance service <span aria-hidden="true">→</span></a>
          </li>
          <li>
            <a href="/portal/account/delete">Account controls <span aria-hidden="true">→</span></a>
          </li>
        </div>
      </section>

      <section class="app-section" aria-labelledby="signout-heading">
        <div class="app-section__head">
          <h2 id="signout-heading">Leave this device</h2><p>Session control</p>
        </div>
        <div class="app-actions">
          <form method="post" action="/api/portal/logout">
            <button class="app-action" type="submit">Sign out this device</button>
          </form>
          <span class="app-note">Account deletion is available under Account controls.</span>
        </div>
      </section>
    </div>
  </section>
</Base>
