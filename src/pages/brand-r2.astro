---
// THROWAWAY: brand-r2 contact sheet. Shows the 4 visual worlds from
// the revised exploration (round 2). Will be deleted once the user
// locks a name and a direction. Does not replace any production
// page or layout.
import Base from "@layouts/Base.astro";
import "../styles/brand-explorer.css";
---

<Base
  title="Brand R2 — four worlds — The Social Club"
  description="Internal comparison of four visual worlds from the revised exploration. Throwaway."
  canonicalPath="/brand-r2/"
>
  <section class="bx-section">
    <div class="bx-container">
      <p class="bx-eyebrow">Internal · throwaway · not for indexing</p>
      <h1>Brand R2 — four worlds</h1>
      <p class="bx-lede">
        Four visual worlds are defined in
        <a href="/explorations/brand/docs/08-worlds-overview.md"
          >explorations/brand/docs/08-worlds-overview.md</a
        >. This page is a single contact-sheet so the choice can be made by looking. The visual
        register, palette, identity system, and emotional scorecard of each world are in the worlds
        overview.
      </p>
      <p class="bx-lede">
        Naming candidates: <a href="/explorations/brand/docs/01-naming-r2.md">01-naming-r2.md</a> (41
        names, 5 shortlisted).
      </p>
      <p class="bx-lede">
        Decision package: <a href="/explorations/brand/docs/09-DECISION-PACKAGE-R2.md"
          >09-DECISION-PACKAGE-R2.md</a
        >. Previous round: <a href="/explorations/brand/docs/00-DECISION_PACKAGE.md"
          >00-DECISION_PACKAGE.md</a
        >.
      </p>
      <nav class="bx-jump" aria-label="World navigation">
        <a href="#world-1">W1 · On Schedule</a>
        <a href="#world-2">W2 · In The Post</a>
        <a href="#world-3">W3 · Cordially</a>
        <a href="#world-4">W4 · A Small Programme</a>
        <a href="#side-by-side">Side-by-side</a>
      </nav>
    </div>
  </section>

  <section id="world-1" class="bx-section bx-direction">
    <div class="bx-container">
      <p class="bx-eyebrow">World 1</p>
      <h2>On Schedule</h2>
      <p class="bx-tagline">
        The calendar is the artefact. Cancellation is the design. Contemporary editorial, ink on
        cream, single orange accent. No seal. Recurring graphic device: a calendar cell with a state
        indicator.
      </p>
      <div class="bx-grid">
        <figure>
          <img src="/explorations/brand/r2-assets/w1/hero_001.jpg" alt="W1 hero" loading="lazy" />
          <figcaption>Hero · calendar cell on cream</figcaption>
        </figure>
        <figure>
          <img
            src="/explorations/brand/r2-assets/w1/invite_001.jpg"
            alt="W1 invite"
            loading="lazy"
          />
          <figcaption>Invite · date + dot</figcaption>
        </figure>
        <figure>
          <img
            src="/explorations/brand/r2-assets/w1/cancel_001.jpg"
            alt="W1 cancel"
            loading="lazy"
          />
          <figcaption>Cancel · same form, strike-through</figcaption>
        </figure>
        <figure>
          <img src="/explorations/brand/r2-assets/w1/card_001.jpg" alt="W1 card" loading="lazy" />
          <figcaption>Card · single number, single dot</figcaption>
        </figure>
        <figure>
          <img
            src="/explorations/brand/r2-assets/w1/birthday_001.jpg"
            alt="W1 birthday"
            loading="lazy"
          />
          <figcaption>Birthday · "0%" visual pun + line</figcaption>
        </figure>
        <figure>
          <img
            src="/explorations/brand/r2-assets/w1/package_001.jpg"
            alt="W1 package"
            loading="lazy"
          />
          <figcaption>Package · folded paper sleeve</figcaption>
        </figure>
        <figure>
          <img src="/explorations/brand/r2-assets/w1/og_001.jpg" alt="W1 OG" loading="lazy" />
          <figcaption>OG · single dot, wide negative space</figcaption>
        </figure>
        <figure>
          <img
            src="/explorations/brand/r2-assets/w1/supporting_001.jpg"
            alt="W1 supporting"
            loading="lazy"
          />
          <figcaption>Supporting · the dot is the brand</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section id="world-2" class="bx-section bx-direction">
    <div class="bx-container">
      <p class="bx-eyebrow">World 2</p>
      <h2>In The Post</h2>
      <p class="bx-tagline">
        The mailbox is the emotional centre. Warm paper on warm wood, hand-written marks, sage +
        brick accents. The artefact is the letter.
      </p>
      <div class="bx-grid">
        <figure>
          <img src="/explorations/brand/r2-assets/w2/hero_001.jpg" alt="W2 hero" loading="lazy" />
          <figcaption>Hero · envelope on warm wood</figcaption>
        </figure>
        <figure>
          <img
            src="/explorations/brand/r2-assets/w2/invite_001.jpg"
            alt="W2 invite"
            loading="lazy"
          />
          <figcaption>Invite · hand-written card</figcaption>
        </figure>
        <figure>
          <img
            src="/explorations/brand/r2-assets/w2/cancel_001.jpg"
            alt="W2 cancel"
            loading="lazy"
          />
          <figcaption>Cancel · same form, gentler</figcaption>
        </figure>
        <figure>
          <img src="/explorations/brand/r2-assets/w2/card_001.jpg" alt="W2 card" loading="lazy" />
          <figcaption>Card · warm paper, hand mark</figcaption>
        </figure>
        <figure>
          <img
            src="/explorations/brand/r2-assets/w2/birthday_001.jpg"
            alt="W2 birthday"
            loading="lazy"
          />
          <figcaption>Birthday · warm paper card</figcaption>
        </figure>
        <figure>
          <img
            src="/explorations/brand/r2-assets/w2/package_001.jpg"
            alt="W2 package"
            loading="lazy"
          />
          <figcaption>Package · unbleached paper sleeve</figcaption>
        </figure>
        <figure>
          <img src="/explorations/brand/r2-assets/w2/og_001.jpg" alt="W2 OG" loading="lazy" />
          <figcaption>OG · envelope, warm light</figcaption>
        </figure>
        <figure>
          <img
            src="/explorations/brand/r2-assets/w2/supporting_001.jpg"
            alt="W2 supporting"
            loading="lazy"
          />
          <figcaption>Supporting · letter as object</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section id="world-3" class="bx-section bx-direction">
    <div class="bx-container">
      <p class="bx-eyebrow">World 3</p>
      <h2>Cordially</h2>
      <p class="bx-tagline">
        Single-word brand mark, contemporary, slightly surprising. The wordmark is the identity.
        Off-white paper, vermilion red, confident type. The artefact is the type.
      </p>
      <div class="bx-grid">
        <figure>
          <img src="/explorations/brand/r2-assets/w3/hero_001.jpg" alt="W3 hero" loading="lazy" />
          <figcaption>Hero · off-white card + red dot</figcaption>
        </figure>
        <figure>
          <img
            src="/explorations/brand/r2-assets/w3/invite_001.jpg"
            alt="W3 invite"
            loading="lazy"
          />
          <figcaption>Invite · same form, single mark</figcaption>
        </figure>
        <figure>
          <img
            src="/explorations/brand/r2-assets/w3/cancel_001.jpg"
            alt="W3 cancel"
            loading="lazy"
          />
          <figcaption>Cancel · same form, same form</figcaption>
        </figure>
        <figure>
          <img src="/explorations/brand/r2-assets/w3/card_001.jpg" alt="W3 card" loading="lazy" />
          <figcaption>Card · single number, red dot</figcaption>
        </figure>
        <figure>
          <img
            src="/explorations/brand/r2-assets/w3/birthday_001.jpg"
            alt="W3 birthday"
            loading="lazy"
          />
          <figcaption>Birthday · folded card + red dot</figcaption>
        </figure>
        <figure>
          <img
            src="/explorations/brand/r2-assets/w3/package_001.jpg"
            alt="W3 package"
            loading="lazy"
          />
          <figcaption>Package · off-white sleeve</figcaption>
        </figure>
        <figure>
          <img src="/explorations/brand/r2-assets/w3/og_001.jpg" alt="W3 OG" loading="lazy" />
          <figcaption>OG · tiny dot, wide negative space</figcaption>
        </figure>
        <figure>
          <img
            src="/explorations/brand/r2-assets/w3/supporting_001.jpg"
            alt="W3 supporting"
            loading="lazy"
          />
          <figcaption>Supporting · the dot, full bleed</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section id="world-4" class="bx-section bx-direction">
    <div class="bx-container">
      <p class="bx-eyebrow">World 4</p>
      <h2>A Small Programme</h2>
      <p class="bx-tagline">
        The invitation is a play programme. The cancellation is a curtain-down beat. Warm cream,
        oxblood red, contemporary small-theatre register. Slightly absurd.
      </p>
      <div class="bx-grid">
        <figure>
          <img src="/explorations/brand/r2-assets/w4/hero_001.jpg" alt="W4 hero" loading="lazy" />
          <figcaption>Hero · cream programme + oxblood mark</figcaption>
        </figure>
        <figure>
          <img
            src="/explorations/brand/r2-assets/w4/invite_001.jpg"
            alt="W4 invite"
            loading="lazy"
          />
          <figcaption>Invite · folded programme</figcaption>
        </figure>
        <figure>
          <img
            src="/explorations/brand/r2-assets/w4/cancel_001.jpg"
            alt="W4 cancel"
            loading="lazy"
          />
          <figcaption>Cancel · same programme, oxblood stamp</figcaption>
        </figure>
        <figure>
          <img src="/explorations/brand/r2-assets/w4/card_001.jpg" alt="W4 card" loading="lazy" />
          <figcaption>Card · folded programme, oxblood dot</figcaption>
        </figure>
        <figure>
          <img
            src="/explorations/brand/r2-assets/w4/birthday_001.jpg"
            alt="W4 birthday"
            loading="lazy"
          />
          <figcaption>Birthday · programme card</figcaption>
        </figure>
        <figure>
          <img
            src="/explorations/brand/r2-assets/w4/package_001.jpg"
            alt="W4 package"
            loading="lazy"
          />
          <figcaption>Package · cream sleeve, oxblood ring</figcaption>
        </figure>
        <figure>
          <img src="/explorations/brand/r2-assets/w4/og_001.jpg" alt="W4 OG" loading="lazy" />
          <figcaption>OG · single oxblood mark</figcaption>
        </figure>
        <figure>
          <img
            src="/explorations/brand/r2-assets/w4/supporting_001.jpg"
            alt="W4 supporting"
            loading="lazy"
          />
          <figcaption>Supporting · the mark, close</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section id="side-by-side" class="bx-section">
    <div class="bx-container">
      <p class="bx-eyebrow">Comparison</p>
      <h2>The four worlds, side by side</h2>
      <p class="bx-tagline">
        The hero of each world, at the same size, for direct visual comparison.
      </p>
      <div class="bx-grid bx-grid--compare">
        <figure>
          <img src="/explorations/brand/r2-assets/w1/hero_001.jpg" alt="W1 hero" loading="lazy" />
          <figcaption>W1 · On Schedule</figcaption>
        </figure>
        <figure>
          <img src="/explorations/brand/r2-assets/w2/hero_001.jpg" alt="W2 hero" loading="lazy" />
          <figcaption>W2 · In The Post</figcaption>
        </figure>
        <figure>
          <img src="/explorations/brand/r2-assets/w3/hero_001.jpg" alt="W3 hero" loading="lazy" />
          <figcaption>W3 · Cordially</figcaption>
        </figure>
        <figure>
          <img src="/explorations/brand/r2-assets/w4/hero_001.jpg" alt="W4 hero" loading="lazy" />
          <figcaption>W4 · A Small Programme</figcaption>
        </figure>
      </div>
      <p class="bx-tagline">The OG of each world, at the same size.</p>
      <div class="bx-grid bx-grid--compare">
        <figure>
          <img src="/explorations/brand/r2-assets/w1/og_001.jpg" alt="W1 OG" loading="lazy" />
          <figcaption>W1 OG</figcaption>
        </figure>
        <figure>
          <img src="/explorations/brand/r2-assets/w2/og_001.jpg" alt="W2 OG" loading="lazy" />
          <figcaption>W2 OG</figcaption>
        </figure>
        <figure>
          <img src="/explorations/brand/r2-assets/w3/og_001.jpg" alt="W3 OG" loading="lazy" />
          <figcaption>W3 OG</figcaption>
        </figure>
        <figure>
          <img src="/explorations/brand/r2-assets/w4/og_001.jpg" alt="W4 OG" loading="lazy" />
          <figcaption>W4 OG</figcaption>
        </figure>
      </div>
    </div>
  </section>
</Base>
