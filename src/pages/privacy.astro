---
import Base from "@layouts/Base.astro";
---

<Base
  title="Privacy — The Social Club"
  description="How the Society handles your data."
  canonicalPath="/privacy/"
>
  <section class="section">
    <div class="container">
      <h1>Privacy</h1>
      <p>
        The Society remembers what you choose to share, and nothing more. Member memory is
        transparent, editable and removable. The Society does not silently enrich members from
        public sources.
      </p>
      <p>Full privacy policy text will be published before the paid launch.</p>
    </div>
  </section>
</Base>
