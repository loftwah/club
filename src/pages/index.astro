---
import { runtimeEnv } from "@lib/runtime-env";
import Base from "@layouts/Base.astro";
import PlanLifecycle from "@components/plan-lifecycle";
import "@components/plan-lifecycle/PlanLifecycle.css";
import { ArrowUpRight, CalendarDays, Mail, ShieldCheck, VolumeX } from "@lucide/astro";
import { brand, formatPrice } from "../brand/config";
import { withCounter } from "../lib/counter";

const stats = await withCounter(runtimeEnv);

const tiers = [brand.tiers.member, brand.tiers.corresponding, brand.tiers.deluxe];
---

<Base
  title={brand.name}
  description={brand.seo.description}
  canonicalPath="/"
  ogImagePath="/og/default.svg"
>
  <section class="dispatch-hero" aria-labelledby="hero-title">
    <div class="shell dispatch-hero__docket" aria-label="Product summary">
      <span>Membership / Melbourne</span>
      <span>Ordinary plans / Cancelled as promised</span>
      <span>Issue 001 / Waitlist</span>
    </div>

    <div class="shell dispatch-hero__grid">
      <div class="dispatch-hero__copy">
        <h1 id="hero-title">
          Plans are made.<br />
          <span>Then unmade.</span><br />
          You remain.
        </h1>
        <div class="dispatch-mobile-status" aria-label="Illustrative plan status">
          <span>A future date / No attendance required</span>
          <strong>Cancelled, as promised.</strong>
        </div>
        <div class="dispatch-hero__intro">
          <p>
            A real membership built around invitations you are never expected to accept. We make
            thoughtful plans with you, cancel them on purpose, and keep the relationship going.
          </p>
          <a href="/waiting-list/" class="hero__cta">
            Join the waitlist <ArrowUpRight size={16} stroke-width={1.8} aria-hidden="true" />
          </a>
          <small>Paid membership is not open. No card required.</small>
        </div>
      </div>

      <aside class="dispatch-card" aria-label="Illustration of a typical plan being cancelled">
        <div class="dispatch-card__top">
          <span>PWY / Ordinary plan</span>
          <span>Illustrative plan only</span>
        </div>
        <div class="dispatch-card__date">
          <span class="dispatch-card__month">A month<br />in the future</span>
          <strong aria-hidden="true">24</strong>
          <span class="dispatch-card__day">One evening<br />No attendance required</span>
        </div>
        <div class="dispatch-card__plan">
          <span>18:30</span>
          <p>Something plausible<br />somewhere nearby</p>
          <span>On schedule</span>
        </div>
        <div class="dispatch-card__code" aria-label="Illustrative plan reference">
          <span>PWY-ORDINARY-0024</span><i aria-hidden="true"></i>
        </div>
        <div class="dispatch-card__cancelled">
          <span>Plan update</span>
          <strong>Cancelled, as promised.</strong>
          <span>Promise kept</span>
        </div>
        <ol class="dispatch-card__rail" aria-label="A plan's sequence">
          <li><span>01</span> Invitation arrives</li>
          <li><span>02</span> Anticipation is optional</li>
          <li class="is-current"><span>03</span> The plan is unmade</li>
          <li><span>04</span> The relationship continues</li>
        </ol>
      </aside>
    </div>

    <dl class="shell data-strip dispatch-hero__facts">
      <div><dt>Belonging</dt><dd>Equal at every tier</dd></div>
      <div><dt>Attendance</dt><dd>Never expected</dd></div>
      <div><dt>Communication</dt><dd>Silence is valid</dd></div>
      <div><dt>Current access</dt><dd>Waitlist only</dd></div>
    </dl>
  </section>

  <section class="manifesto" aria-labelledby="manifesto-title">
    <div class="shell manifesto__grid">
      <div>
        <h2 id="manifesto-title">You were on the list the whole time.</h2>
      </div>
      <div class="manifesto__letter">
        <p>
          Most clubs ask you to prove you belong by turning up. Plans With You does not. The
          invitation carries the feeling; the cancellation carries the relief; the memory carries
          the relationship.
        </p>
        <p class="manifesto__signoff">Warmly,<br /><em>Plans With You</em></p>
      </div>
    </div>
  </section>

  <section class="lifecycle-section" aria-labelledby="lifecycle-title">
    <div class="shell lifecycle-section__intro">
      <div>
        <h2 id="lifecycle-title">Cancellation is the destination.</h2>
      </div>
      <p>
        This is an example, not a real event or venue booking. Every ordinary plan is made with a
        clear date, then cancelled before you ever have to go. If something gets in the way, a
        person steps in.
      </p>
    </div>
    <div class="shell lifecycle-section__stage">
      <PlanLifecycle
        state="cancelled"
        staticMode={true}
        event={{
          id: "illustrative-ordinary-plan",
          title: "An ordinary plan, successfully unmade",
          date: "A future date from the invitation",
          chapter: "Your chosen chapter",
          status: "Cancelled on purpose",
          location: "A plausible place, confirmed before use",
          detail:
            "An example only. No real venue, booking, endorsement, or partnership is implied.",
        }}
      />
    </div>
    <div class="shell lifecycle-section__key">
      <p><span aria-hidden="true">●</span> The promised result</p>
      <p>No RSVP / No check-in / No no-show / No attendance required</p>
    </div>
  </section>

  <section class="counter-wall" aria-labelledby="counter-title">
    <div class="shell counter-wall__grid">
      <h2 id="counter-title">We won’t pretend there’s a crowd.</h2>
      <div
        class="counter-wall__copy"
        data-testid="public-cancelled-counter"
        data-counter-status={stats.status}
        data-counter-value={stats.status === "available" ? stats.cancelledEvents : undefined}
      >
        {
          stats.status === "unavailable" ? (
            <p>
              We can’t confirm the number right now, so we’re leaving it unreported until the record
              is available again.
            </p>
          ) : stats.cancelledEvents > 0 ? (
            <p>
              So far, <strong>{stats.cancelledEvents}</strong> ordinary{" "}
              {stats.cancelledEvents === 1 ? "plan has" : "plans have"} been made and deliberately
              cancelled. That is {stats.cancelledEvents === 1 ? "one promise" : "a set of promises"}{" "}
              kept without asking anyone to turn up.
            </p>
          ) : (
            <p>
              No ordinary plans have been completed yet. When that changes, we’ll say so. Until
              then, zero is the honest number.
            </p>
          )
        }
      </div>
    </div>
  </section>

  <section class="two-worlds" aria-labelledby="worlds-title">
    <div class="shell two-worlds__heading">
      <h2 id="worlds-title">On schedule.<br /><span>In the post.</span></h2>
    </div>
    <div class="two-worlds__grid">
      <article class="world-card world-card--schedule">
        <div class="world-card__icon">
          <CalendarDays size={26} stroke-width={1.6} aria-hidden="true" />
        </div>
        <h3>The calendar is the artefact.</h3>
        <p>
          Invitations, approaching dates, clear updates, cancellation windows, and a history of
          plans that ended exactly as promised.
        </p>
        <a href="/how-it-works/">Follow a plan <ArrowUpRight size={15} aria-hidden="true" /></a>
      </article>
      <article class="world-card world-card--post">
        <div class="world-card__icon"><Mail size={26} stroke-width={1.6} aria-hidden="true" /></div>
        <h3>Care takes physical form.</h3>
        <p>
          Correspondence, cards, milestone objects, and human attention become more tangible at
          higher tiers—only when your membership includes them and you have asked for them.
        </p>
        <a href="/correspondence/"
          >See what may arrive <ArrowUpRight size={15} aria-hidden="true" /></a
        >
      </article>
    </div>
  </section>

  <section class="membership-section" aria-labelledby="membership-title">
    <div class="shell membership-section__heading">
      <div>
        <h2 id="membership-title">More tangible.<br />Never more belonging.</h2>
      </div>
      <p>
        Every member is equally wanted. Higher tiers add more physical mail and human attention—not
        status, greater belonging, or an obligation to engage.
      </p>
    </div>
    <div class="shell tiers tiers--home">
      {
        tiers.map((tier, index) => (
          <article class="tier">
            <h3>{tier.name}</h3>
            <p class="tier__price">
              {formatPrice(tier.priceAud)}
              <small>AUD / month</small>
            </p>
            <p class="tier__tagline">{tier.tagline}</p>
            <p class="tier__positioning">{tier.positioning}</p>
            <ul>
              {tier.includes.slice(0, 4).map((line) => (
                <li>{line}</li>
              ))}
            </ul>
            <a
              href={`/waiting-list/?tier=${index === 0 ? "member" : index === 1 ? "corresponding" : "deluxe"}`}
            >
              Register interest <ArrowUpRight size={14} aria-hidden="true" />
            </a>
          </article>
        ))
      }
    </div>
    <p class="shell membership-section__note">
      These are preview prices. Paid membership is not open, and we will not ask for a card.
    </p>
  </section>

  <section class="quiet-belonging" aria-labelledby="quiet-title">
    <div class="shell quiet-belonging__grid">
      <div class="quiet-belonging__title">
        <VolumeX size={34} stroke-width={1.4} aria-hidden="true" />
        <h2 id="quiet-title">Silence is a successful membership.</h2>
      </div>
      <div class="quiet-belonging__rules">
        <article>
          <span>01</span><h3>No social homework</h3><p>
            No posting, networking, streak, reply, or regular login is required.
          </p>
        </article>
        <article>
          <span>02</span><h3>Memory you control</h3><p>
            Inspect, correct, restrict, revoke, or delete what you have chosen to share.
          </p>
        </article>
        <article>
          <span>03</span><h3>You choose each extra</h3><p>
            Post, gifts, calls, help with commitments, and in-person help are separate choices.
          </p>
        </article>
        <article>
          <span>04</span><h3>AI stays in its place</h3><p>
            AI may help with a draft. It cannot invent things about you or ignore your choices.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="trust-section" aria-labelledby="trust-title">
    <div class="shell trust-section__grid">
      <div>
        <ShieldCheck size={34} stroke-width={1.4} aria-hidden="true" />
        <h2 id="trust-title">Nothing remembered behind your back.</h2>
      </div>
      <div>
        <p>
          We only use details you have confirmed. Suggestions stay separate until you approve them,
          and anything you reject or withdraw is left alone. You can see, change, or remove what we
          remember. If something cannot be completed safely, a person steps in.
        </p>
        <a href="/privacy/" class="button button--paper"
          >Read the privacy approach <ArrowUpRight size={15} aria-hidden="true" /></a
        >
      </div>
    </div>
  </section>

  <section class="final-invitation" aria-labelledby="final-title">
    <div class="shell final-invitation__grid">
      <h2 id="final-title">Put your name on a list you never have to perform for.</h2>
      <div>
        <p>
          Register your interest in Member, Corresponding Member, or Deluxe Member. We will write
          when there is something real to say.
        </p>
        <a href="/waiting-list/" class="hero__cta button--signal">
          Join the waitlist <ArrowUpRight size={16} aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .dispatch-hero {
    border-bottom: 1px solid var(--ink);
  }
  .dispatch-hero__docket {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    padding-block: 0.65rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink-faint);
    font-family: var(--font-data);
    font-size: 0.6rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }
  .dispatch-hero__docket span:nth-child(2) {
    text-align: center;
  }
  .dispatch-hero__docket span:last-child {
    text-align: right;
  }
  .dispatch-hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    padding-block: clamp(1.75rem, 3vw, 2.5rem);
  }
  .dispatch-hero__copy {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(20rem, 0.85fr);
    gap: clamp(2rem, 7vw, 8rem);
    align-items: end;
  }
  .dispatch-hero__copy h1 {
    max-width: 11ch;
    margin: 0;
    font-size: clamp(3.8rem, 6vw, 5.8rem);
  }
  .dispatch-hero__copy h1 span {
    color: var(--signal-text);
  }
  .dispatch-hero__intro {
    display: grid;
    grid-template-columns: minmax(16rem, 32rem) auto;
    gap: 1rem 1.5rem;
    align-items: end;
  }
  .dispatch-hero__intro p {
    margin: 0;
    color: var(--ink-soft);
    font-family: var(--font-letter);
    font-size: clamp(1.1rem, 1.7vw, 1.45rem);
    line-height: 1.35;
  }
  .dispatch-hero__intro small {
    grid-column: 2;
    color: var(--ink-faint);
    font-family: var(--font-data);
    font-size: 0.58rem;
    text-transform: uppercase;
  }
  .dispatch-mobile-status {
    display: none;
  }
  .dispatch-card {
    position: relative;
    display: grid;
    grid-template-areas:
      "top top"
      "date rail"
      "plan rail"
      "cancel cancel"
      "code code";
    grid-template-columns: minmax(0, 1.45fr) minmax(16rem, 0.55fr);
    overflow: hidden;
    border: 1px solid var(--ink);
    background: var(--paper-light);
    box-shadow: 0 1.4rem 3.2rem rgb(18 17 15 / 16%);
  }
  .dispatch-card__top,
  .dispatch-card__plan,
  .dispatch-card__cancelled {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.65rem 0.8rem;
    font-family: var(--font-data);
    font-size: 0.56rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .dispatch-card__top {
    grid-area: top;
    background: var(--calendar);
    color: #fff;
  }
  .dispatch-card__date {
    grid-area: date;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 10rem;
    padding: 1.25rem;
    border-bottom: 1px dashed var(--ink);
  }
  .dispatch-card__date strong {
    font-size: clamp(4.5rem, 8vw, 5.8rem);
    font-weight: 720;
    letter-spacing: -0.09em;
    line-height: 0.75;
  }
  .dispatch-card__month,
  .dispatch-card__day {
    font-family: var(--font-data);
    font-size: 0.56rem;
    line-height: 1.5;
    text-transform: uppercase;
  }
  .dispatch-card__day {
    text-align: right;
  }
  .dispatch-card__plan {
    grid-area: plan;
    align-items: center;
    border-bottom: 1px solid var(--ink);
  }
  .dispatch-card__plan p {
    flex: 1;
    margin: 0;
    font-family: var(--font-letter);
    font-size: 1rem;
    text-transform: none;
  }
  .dispatch-card__code {
    display: flex;
    grid-area: code;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.6rem;
    padding: 0.55rem 0.8rem;
    border-bottom: 1px dashed var(--ink);
    font-family: var(--font-data);
    font-size: 0.56rem;
    letter-spacing: 0.05em;
  }
  .dispatch-card__code i {
    width: min(9rem, 45%);
    height: 1.2rem;
    background: repeating-linear-gradient(
      90deg,
      var(--ink) 0 1px,
      transparent 1px 3px,
      var(--ink) 3px 5px,
      transparent 5px 8px
    );
  }
  .dispatch-card__cancelled {
    display: grid;
    grid-area: cancel;
    padding: 1rem;
    background: var(--signal);
    color: var(--ink);
  }
  .dispatch-card__cancelled strong {
    font-size: clamp(1.5rem, 3vw, 2.7rem);
    letter-spacing: -0.045em;
    line-height: 0.95;
  }
  .dispatch-card__rail {
    display: grid;
    grid-area: rail;
    gap: 0;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--ink);
    list-style: none;
  }
  .dispatch-card__rail li {
    display: grid;
    grid-template-columns: 2.3rem 1fr;
    padding: 0.55rem 0.8rem;
    border-top: 1px solid var(--line);
    color: var(--ink-faint);
    font-family: var(--font-data);
    font-size: 0.61rem;
    text-transform: uppercase;
  }
  .dispatch-card__rail .is-current {
    color: var(--signal-text);
  }
  .dispatch-hero__facts {
    padding-inline: var(--gutter);
  }
  .manifesto {
    padding-block: var(--section-space);
    background: var(--calendar);
    color: white;
  }
  .manifesto__grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: clamp(3rem, 10vw, 10rem);
    align-items: start;
  }
  .manifesto .eyebrow {
    color: #fff;
  }
  .manifesto h2 {
    max-width: 12ch;
    margin: 1rem 0 0;
    font-size: clamp(3.5rem, 7vw, 5.8rem);
  }
  .manifesto__letter {
    padding: clamp(1.5rem, 3vw, 3rem);
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 1.4rem 3rem rgb(0 0 0 / 22%);
    transform: rotate(-1deg);
  }
  .manifesto__letter p {
    font-family: var(--font-letter);
    font-size: clamp(1.15rem, 2vw, 1.55rem);
    line-height: 1.5;
  }
  .manifesto__signoff {
    margin-top: 3rem;
  }
  .manifesto__signoff em {
    color: var(--signal-text);
    font-size: 1.4em;
  }
  .lifecycle-section {
    padding-block: var(--section-space);
    border-bottom: 1px solid var(--ink);
  }
  .lifecycle-section__intro {
    display: grid;
    grid-template-columns: 1fr 0.7fr;
    gap: 3rem;
    align-items: end;
  }
  .lifecycle-section__intro h2 {
    max-width: 12ch;
    margin: 1rem 0 0;
    font-size: clamp(3rem, 6vw, 5.8rem);
  }
  .lifecycle-section__intro > p {
    max-width: 35rem;
    margin: 0;
    color: var(--ink-soft);
    font-family: var(--font-letter);
    font-size: 1.15rem;
  }
  .lifecycle-section__stage {
    display: grid;
    margin-top: 4rem;
    place-items: center;
  }
  .lifecycle-section__key {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    margin-top: 1rem;
    color: var(--ink-faint);
    font-family: var(--font-data);
    font-size: 0.62rem;
    text-transform: uppercase;
  }
  .lifecycle-section__key p:first-child span {
    color: var(--ok);
  }
  .counter-wall {
    padding-block: var(--section-space);
    background: var(--ink);
    color: var(--paper);
  }
  .counter-wall__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(18rem, 0.85fr);
    gap: clamp(3rem, 10vw, 10rem);
    align-items: end;
  }
  .counter-wall h2 {
    max-width: 12ch;
    margin: 0;
    font-size: clamp(2.2rem, 4vw, 4.2rem);
  }
  .counter-wall__copy p {
    max-width: 34rem;
    margin: 0;
    color: #c9c4b9;
    font-family: var(--font-letter);
    font-size: 1.1rem;
  }
  .counter-wall__copy strong {
    color: var(--signal);
    font-family: var(--font-display);
  }
  .two-worlds {
    padding-block: var(--section-space);
  }
  .two-worlds__heading h2 {
    margin: 1rem 0 3rem;
    font-size: clamp(4rem, 7vw, 5.8rem);
  }
  .two-worlds__heading h2 span {
    color: var(--signal-text);
    font-family: var(--font-letter);
    font-style: italic;
    font-weight: 520;
  }
  .two-worlds__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 1px solid var(--ink);
  }
  .world-card {
    min-height: 31rem;
    padding: clamp(1.5rem, 4vw, 4rem);
  }
  .world-card + .world-card {
    border-left: 1px solid var(--ink);
  }
  .world-card__icon {
    width: max-content;
    margin-bottom: 5rem;
    padding: 0.8rem;
    border: 1px solid currentColor;
  }
  .world-card h3 {
    max-width: 11ch;
    margin: 1rem 0;
    font-size: clamp(2.5rem, 5vw, 5rem);
  }
  .world-card p:not(.eyebrow) {
    max-width: 35rem;
    color: var(--ink-soft);
  }
  .world-card a,
  .tier a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.5rem;
    font-family: var(--font-data);
    font-size: 0.68rem;
    text-transform: uppercase;
  }
  .world-card--schedule {
    background: var(--paper-light);
  }
  .world-card--post {
    background: var(--signal-soft);
  }
  .world-card--post .eyebrow {
    color: var(--ink);
  }
  .membership-section {
    padding-block: var(--section-space);
    border-top: 1px solid var(--ink);
  }
  .membership-section__heading {
    display: grid;
    grid-template-columns: 1.2fr 0.6fr;
    gap: 3rem;
    align-items: end;
  }
  .membership-section__heading h2 {
    margin: 1rem 0 0;
    font-size: clamp(3.4rem, 6vw, 5.8rem);
  }
  .membership-section__heading > p {
    color: var(--ink-soft);
    font-family: var(--font-letter);
    font-size: 1.15rem;
  }
  .tiers--home {
    margin-top: 4rem;
  }
  .tiers--home .tier:nth-child(2) {
    background: #eef0ff;
  }
  .tiers--home .tier:nth-child(3) {
    background: var(--signal-soft);
  }
  .tiers--home .tier:nth-child(3) .eyebrow,
  .tiers--home .tier:nth-child(3) .tier__price small {
    color: var(--ink);
  }
  .membership-section__note {
    color: var(--ink-faint);
    font-family: var(--font-data);
    font-size: 0.62rem;
    text-transform: uppercase;
  }
  .quiet-belonging {
    padding-block: var(--section-space);
    background: var(--paper-deep);
  }
  .quiet-belonging__grid {
    display: grid;
    grid-template-columns: 0.75fr 1.25fr;
    gap: clamp(3rem, 8vw, 8rem);
  }
  .quiet-belonging__title h2 {
    max-width: 10ch;
    margin: 1.2rem 0 0;
    font-size: clamp(3.3rem, 6vw, 5.8rem);
  }
  .quiet-belonging__title .eyebrow {
    color: var(--ink);
  }
  .quiet-belonging__title svg {
    margin-bottom: 2rem;
  }
  .quiet-belonging__rules {
    border-top: 1px solid var(--ink);
  }
  .quiet-belonging__rules article {
    display: grid;
    grid-template-columns: 2rem 1fr 1.2fr;
    gap: 1rem;
