---
import { runtimeEnv } from "@lib/runtime-env";
// Onboarding wizard.
// /onboarding/[step] renders the current step. The wizard is
// resumable: a member can leave at any step and pick up where
// they left off.
//
// The wizard shows the current step, the remaining blockers,
// and never activates a paid member without required gates.
import Base from "@layouts/Base.astro";
import "../../styles/app-surfaces.css";
import {
  OnboardingService,
  ONBOARDING_STEPS,
  type OnboardingStepId,
} from "../../services/onboarding";
import { MembershipService } from "@services/membership-service";
import { SystemClock } from "../../infra/clock";
import { D1AuditWriter } from "../../infra/audit";
import { brand } from "../../brand/config";
import { requireOnboardingSession } from "../../lib/portal-auth";

const stepId = (Astro.params.step ?? "identity") as OnboardingStepId;
const step = ONBOARDING_STEPS.find((s) => s.id === stepId);
if (!step) {
  return Astro.redirect("/onboarding/identity/");
}
const env = runtimeEnv;
const ctx = await requireOnboardingSession(Astro.request, env);
if (!ctx) {
  return Astro.redirect(
    `/portal/login/?next=${encodeURIComponent(`${Astro.url.pathname}${Astro.url.search}`)}`,
  );
}
const audit = new D1AuditWriter(env.DB, new SystemClock());
const clock = new SystemClock();
const ms = new MembershipService({ db: env.DB, audit, clock });
const onboarding = new OnboardingService({ db: env.DB });

// The authenticated session owns exactly one onboarding subject. It is
// never selected by global recency or any public URL parameter.
const applicant = {
  id: ctx.member.id,
  email: ctx.member.email,
  preferred_name: ctx.member.preferredName,
};
const memberId = applicant.id;
const evaluation = memberId ? await ms.evaluateActivation(memberId) : null;

const currentStepIndex = ONBOARDING_STEPS.findIndex((s) => s.id === stepId);
const prevStep = currentStepIndex > 0 ? ONBOARDING_STEPS[currentStepIndex - 1] : null;
const nextStep =
  currentStepIndex < ONBOARDING_STEPS.length - 1 ? ONBOARDING_STEPS[currentStepIndex + 1] : null;

const stepData = memberId ? await onboarding.getStepData(memberId, stepId) : null;
---

<Base
  title={`Onboarding — ${step.title}`}
  description="Set up your membership."
  canonicalPath={`/onboarding/${step.id}/`}
>
  <section class="app-surface">
    <div class="container">
      <header class="app-page-head app-page-head--onboarding">
        <div class="app-page-head__main">
          <p class="app-breadcrumb">
            <a href="/portal/">Portal</a> / Onboarding / {step.title}
          </p>
          <h1>Onboarding</h1>
          <p class="app-lede">
            Step <strong>{step.order}</strong> of {ONBOARDING_STEPS.length} · {step.title}
            {step.requiredForActivation ? " · required" : ""}
          </p>
          {
            applicant ? (
              <p class="app-note">
                Signed in as <strong>{applicant.preferred_name ?? applicant.email}</strong>
              </p>
            ) : (
              <p class="app-note">
                No applicant record. <a href="/waiting-list/">Join the waitlist</a> first.
              </p>
            )
          }
        </div>
        <dl class="app-page-head__aside" aria-label="Current onboarding status">
          <dt>Step</dt>
          <dd>
            {String(step.order).padStart(2, "0")} / {
              String(ONBOARDING_STEPS.length).padStart(2, "0")
            }
          </dd>
          <dt>Type</dt>
          <dd>{step.requiredForActivation ? "Required" : "Optional"}</dd>
        </dl>
      </header>

      {
        evaluation && !evaluation.ready && evaluation.blockers.length > 0 ? (
          <div class="app-callout app-callout--danger onboarding-blockers" role="status">
            <h2>Remaining blockers</h2>
            <ul>
              {evaluation.blockers.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          </div>
        ) : null
      }

      <details class="onboarding-progress-details" name="onboarding-progress">
        <summary>
          <span class="onboarding-progress__summary-label"
            >All {ONBOARDING_STEPS.length} onboarding steps</span
          >
          <span class="onboarding-progress__summary-hint">
            {ONBOARDING_STEPS.length - step.order} remaining after this one
          </span>
        </summary>
        <ol class="onboarding-progress">
          {
            ONBOARDING_STEPS.map((s) => {
              const isCurrent = s.id === stepId;
              const isDone = s.order < step.order;
              const classes = ["onboarding-progress__step"];
              if (isCurrent) classes.push("is-current");
              if (isDone) classes.push("is-done");
              const cls = classes.join(" ");
              return (
                <li class={cls}>
                  <span class="onboarding-progress__num">{s.order}</span>
                  <a href={memberId ? `/onboarding/${s.id}/` : "#"}>{s.title}</a>
                  {s.requiredForActivation ? <span class="pill pill--warn">required</span> : null}
                </li>
              );
            })
          }
        </ol>
      </details>

      <section class="app-section" aria-labelledby="current-step-heading">
        <div class="app-section__head">
          <h2 id="current-step-heading">Step {step.order}: {step.title}</h2>
          <p>{step.requiredForActivation ? "Required" : "Optional"}</p>
        </div>
        <p class="app-lede">{step.description}</p>
      </section>

      {
        step.id === "identity" ? (
          <form class="app-form" method="post" action="/api/onboarding/identity">
            <label for="preferredName">Preferred first name</label>
            <input
              id="preferredName"
              name="preferredName"
              type="text"
              required
              maxlength="120"
              value={
                (stepData as Record<string, string> | null)?.preferredName ??
                applicant?.preferred_name ??
                ""
              }
            />
            <label for="country">Country</label>
            <input
              id="country"
              name="country"
              type="text"
              required
              maxlength="60"
              value={(stepData as Record<string, string> | null)?.country ?? "AU"}
            />
            <label for="metroArea">Metro / city</label>
            <input
              id="metroArea"
              name="metroArea"
              type="text"
              required
              maxlength="120"
              value={(stepData as Record<string, string> | null)?.metroArea ?? ""}
              placeholder="Melbourne"
            />
            <label for="birthday">Birthday (MM-DD)</label>
            <input
              id="birthday"
              name="birthday"
              type="text"
              maxlength="10"
              value={(stepData as Record<string, string> | null)?.birthday ?? ""}
              placeholder="08-15"
            />
            <label for="timezone">Timezone</label>
            <input
              id="timezone"
              name="timezone"
              type="text"
              maxlength="60"
              value={(stepData as Record<string, string> | null)?.timezone ?? "Australia/Melbourne"}
            />
            <div class="app-form__actions">
              <button type="submit" class="app-action">
                Save and continue
              </button>
            </div>
          </form>
        ) : step.id === "chapter" ? (
          <form class="app-form" method="post" action="/api/onboarding/chapter">
            <label for="chapterId">Chapter</label>
            <select id="chapterId" name="chapterId" required>
              <option
                value="chap_melbourne"
                selected={
                  (stepData as Record<string, string> | null)?.chapterId === "chap_melbourne"
                }
              >
                Melbourne — accepting waitlist
              </option>
              <option
                value="chap_sydney"
                selected={(stepData as Record<string, string> | null)?.chapterId === "chap_sydney"}
              >
                Sydney — coming
              </option>
              <option
                value="chap_brisbane"
                selected={
                  (stepData as Record<string, string> | null)?.chapterId === "chap_brisbane"
                }
              >
                Brisbane — coming
              </option>
              <option
                value="chap_adelaide"
                selected={
                  (stepData as Record<string, string> | null)?.chapterId === "chap_adelaide"
                }
              >
                Adelaide — coming
              </option>
              <option
                value="chap_perth"
                selected={(stepData as Record<string, string> | null)?.chapterId === "chap_perth"}
              >
                Perth — coming
              </option>
            </select>
            <div class="app-form__actions">
              <button type="submit" class="app-action">
                Save and continue
              </button>
            </div>
          </form>
        ) : step.id === "tier" ? (
          <form class="app-form" method="post" action="/api/onboarding/tier">
            <label for="tier">Choose your tier</label>
            <div>
              <label>
                <input type="radio" name="tier" value="member" required />{" "}
                <strong>{brand.tiers.member.name}</strong> — A${brand.tiers.member.priceAud}/month ·{" "}
                {brand.tiers.member.tagline}
              </label>
            </div>
            <div>
              <label>
                <input type="radio" name="tier" value="corresponding" required />{" "}
                <strong>{brand.tiers.corresponding.name}</strong> — A$
                {brand.tiers.corresponding.priceAud}/month · {brand.tiers.corresponding.tagline}
              </label>
            </div>
            <div>
              <label>
                <input type="radio" name="tier" value="deluxe" required />{" "}
                <strong>{brand.tiers.deluxe.name}</strong> — A${brand.tiers.deluxe.priceAud}/month ·{" "}
                {brand.tiers.deluxe.tagline}
              </label>
            </div>
            <div class="app-form__actions">
              <button type="submit" class="app-action">
                Save and continue
              </button>
            </div>
          </form>
        ) : step.id === "why" ? (
          <form class="app-form" method="post" action="/api/onboarding/why">
            <label>Why are you joining? (multi-select)</label>
            <div>
              <label>
                <input type="checkbox" name="why" value="cancelled-plans" /> I enjoy having plans
                cancelled.
              </label>
            </div>
            <div>
              <label>
                <input type="checkbox" name="why" value="belong-without-attendance" /> I want to
                feel included without attendance pressure.
              </label>
            </div>
            <div>
              <label>
                <input type="checkbox" name="why" value="correspondence" /> I want proper
                correspondence.
              </label>
            </div>
            <div>
              <label>
                <input type="checkbox" name="why" value="remembered" /> I want to be remembered.
              </label>
            </div>
            <div>
              <label>
                <input type="checkbox" name="why" value="physical-mail" /> I want physical mail.
              </label>
            </div>
            <div>
              <label>
                <input type="checkbox" name="why" value="human-contact" /> I want occasional human
                contact.
              </label>
            </div>
            <div>
              <label>
                <input type="checkbox" name="why" value="manufactured-commitments" /> I want
                manufactured commitments.
              </label>
            </div>
            <div>
              <label>
                <input type="checkbox" name="why" value="gifts" /> I like gifts and surprises.
              </label>
            </div>
            <div>
              <label>
                <input type="checkbox" name="why" value="appearance" /> I may use the appearance
                service.
              </label>
            </div>
            <div>
              <label>
                <input type="checkbox" name="why" value="funny" /> I mostly think this is funny.
              </label>
            </div>
            <div class="app-form__actions">
              <button type="submit" class="app-action">
                Save and continue
              </button>
            </div>
          </form>
        ) : step.id === "event-preferences" ? (
          <form class="app-form" method="post" action="/api/onboarding/event-preferences">
            <label for="frequency">Frequency</label>
            <select id="frequency" name="frequency">
              <option value="occasional">Occasional</option>
              <option value="monthly">About monthly</option>
              <option value="couple-per-month">A couple per month</option>
              <option value="discretion">Use our discretion</option>
            </select>
            <label for="cancellationStyle">Cancellation style</label>
            <select id="cancellationStyle" name="cancellationStyle">
              <option value="merciful">Merciful</option>
              <option value="traditional">Traditional</option>
              <option value="last-minute">Last minute</option>
              <option value="discretion">Use our discretion</option>
            </select>
            <label>
              <input type="checkbox" name="types" value="dinners" /> Dinners
            </label>
            <label>
              <input type="checkbox" name="types" value="gallery" /> Gallery / museum
            </label>
            <label>
              <input type="checkbox" name="types" value="theatre" /> Theatre
            </label>
            <label>
              <input type="checkbox" name="types" value="music" /> Music
            </label>
            <label>
              <input type="checkbox" name="types" value="walks" /> Walks
            </label>
            <label>
              <input type="checkbox" name="types" value="talks" /> Talks
            </label>
            <label>
              <input type="checkbox" name="types" value="cultural" /> Cultural
            </label>
            <label>
              <input type="checkbox" name="types" value="surprise" /> Surprise me
            </label>
            <div class="app-form__actions">
              <button type="submit" class="app-action">
                Save and continue
              </button>
            </div>
          </form>
        ) : step.id === "communications" ? (
          <form class="app-form" method="post" action="/api/onboarding/communications">
            <label>
              <input type="checkbox" name="opt" value="NEWSLETTER" /> Newsletter (slow, mostly text)
            </label>
            <label>
              <input type="checkbox" name="opt" value="CALENDAR_MESSAGES" /> Calendar messages
              (invitations + cancellations)
            </label>
            <label>
              <input type="checkbox" name="opt" value="PHYSICAL_CORRESPONDENCE" /> Physical mail
            </label>
            <label>
              <input type="checkbox" name="opt" value="GIFTS" /> Gifts (incl. surprises)
            </label>
            <label>
              <input type="checkbox" name="opt" value="CALLS" /> Calls (at permitted windows)
            </label>
            <label>
              <input type="checkbox" name="opt" value="MANUFACTURED_COMMITMENTS" /> Manufactured
              commitments
            </label>
            <label>
              <input type="checkbox" name="opt" value="APPEARANCE_INTEREST" /> Appearance service
              interest
            </label>
            <div class="app-form__actions">
              <button type="submit" class="app-action">
                Save and continue
              </button>
            </div>
          </form>
        ) : step.id === "memory" ? (
          <form class="app-form" method="post" action="/api/onboarding/memory">
            <p>
              You may add facts we can use to personalise correspondence. You can edit or remove any
              fact at any time from the portal.
            </p>
            <label for="memoryHint">What should we remember about you? (free text, optional)</label>
            <textarea
              id="memoryHint"
              name="memoryHint"
              rows="3"
              maxlength="600"
              placeholder="My dog Frank; I am doing a pottery class; my birthday is in August."
            />
            <label for="doNotMention">
              What should we <strong>never</strong> mention? (free text, optional)
            </label>
            <textarea id="doNotMention" name="doNotMention" rows="3" maxlength="600" />
            <div class="app-form__actions">
              <button type="submit" class="app-action">
                Save and continue
              </button>
            </div>
          </form>
        ) : step.id === "post" ? (
          <form class="app-form" method="post" action="/api/onboarding/post">
            <label for="postalName">Postal name</label>
            <input id="postalName" name="postalName" type="text" maxlength="200" />
            <label for="addressLine1">Address line 1</label>
            <input id="addressLine1" name="addressLine1" type="text" maxlength="200" required />
            <label for="addressLine2">Address line 2</label>
            <input id="addressLine2" name="addressLine2" type="text" maxlength="200" />
            <label for="suburb">Suburb / city</label>
            <input id="suburb" name="suburb" type="text" maxlength="120" required />
            <label for="postcode">Postcode</label>
            <input id="postcode" name="postcode" type="text" maxlength="20" required />
            <label for="country2">Country</label>
            <input id="country2" name="country" type="text" maxlength="60" required value="AU" />
            <label>
              <input type="checkbox" name="surprisePackages" value="true" /> Surprise packages are
              OK
            </label>
            <div class="app-form__actions">
              <button type="submit" class="app-action">
                Save and continue
              </button>
            </div>
          </form>
        ) : step.id === "gifts" ? (
          <form class="app-form" method="post" action="/api/onboarding/gifts">
            <label>
              <input type="checkbox" name="gifts" value="enabled" checked /> Enable gifts (Deluxe
              Member and above)
            </label>
            <label>
              <input type="checkbox" name="surprises" value="enabled" /> Surprises are OK
            </label>
            <label for="interests">Interests (free text)</label>
            <textarea id="interests" name="interests" rows="2" maxlength="500" />
            <label for="neverSend">Never send (free text)</label>
            <textarea
              id="neverSend"
              name="neverSend"
              rows="2"
              maxlength="500"
              placeholder="no alcohol, no leather, no soy candles"
            />
            <div class="app-form__actions">
              <button type="submit" class="app-action">
                Save and continue
              </button>
            </div>
          </form>
        ) : step.id === "calls" ? (
          <form class="app-form" method="post" action="/api/onboarding/calls">
            <label for="callMode">Mode</label>
            <select id="callMode" name="callMode">
              <option value="NO_CALLS">No calls</option>
              <option value="BIRTHDAY_CALLS">Birthday calls only</option>
              <option value="MILESTONE_CALLS">Milestone calls only</option>
              <option value="OCCASIONAL_CLUB_CALLS">Occasional club calls</option>
              <option value="ALL_ALLOWED">All allowed</option>
            </select>
            <label for="callWindow">Preferred window (local time)</label>
            <input
              id="callWindow"
              name="callWindow"
              type="text"
              maxlength="60"
              placeholder="16:00–18:00"
            />
            <label>
              <input type="checkbox" name="voicemail" value="ok" /> Voicemail is OK
            </label>
            <label>
              <input type="checkbox" name="surpriseCall" value="ok" /> Surprise calls are OK
            </label>
            <div class="app-form__actions">
              <button type="submit" class="app-action">
                Save and continue
              </button>
            </div>
          </form>
        ) : step.id === "manufactured-commitments" ? (
          <form class="app-form" method="post" action="/api/onboarding/manufactured-commitments">
            <p>
              A manufactured commitment is a consensual artificial social obligation. You ask us to
              construct a plausible visitor. You confirm. We create useful pressure and then
              explicitly cancel. You can abort at any time. Nothing dangles.
            </p>
            <label for="mcOptIn">
              <input id="mcOptIn" type="checkbox" name="mcOptIn" value="true" /> I may request
              manufactured commitments in the future
            </label>
            <p class="app-note">
              I understand the scenario is constructed. Fictional names may be used. No one is
              really travelling unless I separately book the appearance service. I can abort at any
              time and we will cancel the scenario.
            </p>
            <div class="app-form__actions">
              <button type="submit" class="app-action">
                Save and continue
              </button>
            </div>
          </form>
        ) : step.id === "appearance-interest" ? (
          <form class="app-form" method="post" action="/api/onboarding/appearance-interest">
            <label for="app">
              <select id="app" name="appearance">
                <option value="INTERESTED">
                  Interested — let me know when the service is available
                </option>
                <option value="ASK_LATER">Ask me later</option>
                <option value="NOT_INTERESTED">Not interested</option>
              </select>
            </label>
            <p class="app-note">
              This is not a booking. Real bookings go through the portal appearance page when the
              service is enabled.
            </p>
            <div class="app-form__actions">
              <button type="submit" class="app-action">
                Save and continue
              </button>
            </div>
          </form>
        ) : step.id === "plain-language" ? (
          <form class="app-form" method="post" action="/api/onboarding/plain-language">
            <p>
              Before paid activation, the {brand.shortName} asks you to explicitly acknowledge in
              plain language that:
            </p>
            <ul>
              <li>ordinary events are constructed;</li>
              <li>ordinary events are intended to be cancelled;</li>
              <li>members are not expected to attend;</li>
              <li>some characters and references are fictional;</li>
              <li>AI and automation may assist personalisation within the rules we set;</li>
              <li>human operators perform selected real-world tasks;</li>
              <li>optional services are controllable.</li>
            </ul>
            <label>
              <input type="checkbox" name="acknowledged" value="true" required /> I have read and
              acknowledge the above.
            </label>
            <div class="app-form__actions">
              <button type="submit" class="app-action">
                Save and continue
              </button>
            </div>
          </form>
        ) : step.id === "terms" ? (
          <form class="app-form" method="post" action="/api/onboarding/terms">
            <p>
              {brand.name} shows the exact document version, effective date, and content hash for
              every acceptance. You can re-accept at any time. Re-acceptance of an updated document
              does not by itself re-charge or change your membership.
            </p>
            <p>
              The current terms and privacy policy are placeholders pending Australian-facing legal
              review. By accepting, you confirm you have read them and agree to the current version.
            </p>
            <label>
              <input type="checkbox" name="termsAccepted" value="true" required /> I accept the
              current Terms.
            </label>
            <label>
              <input type="checkbox" name="privacyAccepted" value="true" required /> I accept the
              current Privacy Policy.
            </label>
            <label>
              <input type="checkbox" name="theatricalAccepted" value="true" required /> I accept the
              Theatrical / Constructed Experience acknowledgement.
            </label>
            <div class="app-form__actions">
              <button type="submit" class="app-action">
                Save and continue
              </button>
            </div>
          </form>
        ) : step.id === "payment-gate" ? (
          <div>
            <p>
              The payment gate is the last step. It is <strong>disabled</strong> in this build. Real
              paid activation is webhook-authoritative (a verified Stripe payment is required) and
              is not enabled until the user explicitly approves paid launch.
            </p>
            <p class="app-note">
              {evaluation?.ready
                ? "All required gates are satisfied. Once Stripe is enabled, the verified payment webhook will activate the membership."
                : "All required gates must be satisfied before activation. See remaining blockers above."}
            </p>
            <p>
              <a href="/onboarding/identity/" class="link-button">
                Review the wizard from the start
              </a>
            </p>
          </div>
        ) : (
          <p>Unknown step.</p>
        )
      }

      <nav class="onboarding-nav" aria-label="Onboarding navigation">
        {prevStep ? <a href={`/onboarding/${prevStep.id}/`}>← {prevStep.title}</a> : <span />}
        {
          nextStep ? (
            <a href={`/onboarding/${nextStep.id}/`}>{nextStep.title} →</a>
          ) : (
            <a href="/portal/">Finish</a>
          )
        }
      </nav>
    </div>
  </section>
</Base>
