---
import Base from "@layouts/Base.astro";
import { brand } from "../brand/config";
import { formatLocality } from "@lib/geography";
import { listChapters } from "@lib/chapters";

// Issue #12: the chapter catalogue is a single source of
// truth (src/lib/chapters.ts). Adding a new non-Australian
// chapter is a one-line change in that file (or a row in the
// `chapters` table) — neither this page nor
// `chapters/[slug].astro` need to be edited.
const chapters = listChapters();
---

<Base
  title="Chapters"
  description={`Where ${brand.name} is accepting waitlist interest, and where a chapter is still forming.`}
  canonicalPath="/chapters/"
>
  <section class="pwy-page pwy-chapters" aria-labelledby="chapters-heading">
    <div class="pwy-shell">
      <header class="pwy-hero">
        <p class="pwy-kicker">The local list / 04</p>
        <div class="pwy-hero__grid">
          <h1 id="chapters-heading">Chapters, opened carefully.</h1>
          <p class="pwy-hero__lede">
            A chapter is a place with people and local knowledge ready to support it, not a
            decorative pin on a map. We open slowly and keep the status honest.
          </p>
        </div>
        <div class="pwy-hero__meta" aria-label="Chapter status">
          <span class="pwy-stamp">Waitlist open</span>
          <span>Paid membership closed</span>
          <span>Only real locations</span>
        </div>
      </header>

      <section class="pwy-chapter-list" aria-labelledby="list-heading">
        <div class="pwy-section-heading">
          <p class="pwy-kicker">The register</p>
          <h2 id="list-heading">Where the list is being kept.</h2>
          <p>
            You can express interest in any location. A waitlist entry is not paid membership and
            does not turn a forming chapter into an active one.
          </p>
        </div>
        <div class="pwy-chapter-grid">
          {
            chapters.map((chapter, index) => (
              <article
                class={`pwy-chapter-card${chapter.status === "ACTIVE" ? " pwy-chapter-card--active" : ""}`}
              >
                <div class="pwy-chapter-card__topline">
                  <span>0{index + 1}</span>
                  <span class="pwy-status">
                    {chapter.status === "ACTIVE" ? "Accepting waitlist" : "Forming"}
                  </span>
                </div>
                <h3>
                  <a href={`/chapters/${chapter.slug}/`}>{chapter.name}</a>
                </h3>
                <p class="pwy-chapter-card__locality">{formatLocality(chapter)}</p>
                <p>{chapter.note}</p>
                <a class="pwy-chapter-card__link" href={`/waiting-list/?chapter=${chapter.slug}`}>
                  Register interest <span aria-hidden="true">↗</span>
                </a>
              </article>
            ))
          }
        </div>
      </section>

      <section class="pwy-chapter-principles" aria-labelledby="principles-heading">
        <div>
          <p class="pwy-kicker">What a chapter means</p>
          <h2 id="principles-heading">Local detail, same arrangement.</h2>
        </div>
        <div class="pwy-prose">
          <p>
            Chapter-specific references and correspondence are written for the place members
            actually give us. Any location used in an ordinary plan is part of an example, not a
            venue partner or a real booking.
          </p>
          <p>
            The core stays constant: plans are made, then cancelled; correspondence continues; and
            every member remains equally wanted regardless of tier, activity or attendance.
          </p>
        </div>
      </section>

      <footer class="pwy-page-footer">
        <p>Tell us where you would like the next chapter to be.</p>
        <a class="pwy-button" href="/waiting-list/"
          >Join the waitlist <span aria-hidden="true">↗</span></a
        >
      </footer>
    </div>
  </section>
</Base>

<style>
  .pwy-page {
    color: var(--fg);
  }
  .pwy-hero {
    padding: clamp(3.5rem, 9vw, 7rem) 0 clamp(2.5rem, 6vw, 4.5rem);
    border-bottom: 1px solid var(--line);
  }
  .pwy-kicker {
    margin: 0 0 1rem;
    color: var(--fg-faint);
    font: 600 0.72rem/1.2 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .pwy-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(16rem, 0.9fr);
    gap: clamp(2rem, 8vw, 9rem);
    align-items: end;
  }
  .pwy-hero h1 {
    max-width: 12ch;
    margin: 0;
    font-size: clamp(2.6rem, 6vw, 4.6rem);
    line-height: 0.95;
    font-weight: 680;
  }
  .pwy-hero__lede {
    max-width: 38rem;
    margin: 0;
    color: var(--fg-muted);
    font-size: clamp(1.1rem, 1.8vw, 1.45rem);
    line-height: 1.35;
  }
  .pwy-hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.4rem;
    margin-top: 2.5rem;
    color: var(--fg-faint);
    font: 0.72rem/1.2 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .pwy-stamp {
    color: var(--accent);
  }
  .pwy-chapter-list {
    padding: clamp(3.5rem, 8vw, 6.5rem) 0;
    border-bottom: 1px solid var(--line);
  }
  .pwy-section-heading {
    max-width: 44rem;
  }
  .pwy-section-heading h2,
  .pwy-chapter-principles h2 {
    margin: 0 0 1rem;
    font: 400 clamp(2rem, 4vw, 3.5rem)/0.98 var(--font-serif);
    letter-spacing: -0.035em;
  }
  .pwy-section-heading > p:last-child {
    color: var(--fg-muted);
  }
  .pwy-chapter-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    margin-top: 3rem;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .pwy-chapter-card {
    display: flex;
    flex-direction: column;
    min-height: 17rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    background: var(--bg);
  }
  .pwy-chapter-card--active {
    background: var(--accent-soft);
  }
  .pwy-chapter-card--active .pwy-chapter-card__topline > span:first-child {
    color: var(--fg);
  }
  .pwy-chapter-card__topline {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--fg-faint);
    font: 0.68rem/1.2 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .pwy-status {
    color: var(--accent-secondary);
  }
  .pwy-chapter-card h3 {
    margin: 2.5rem 0 0.7rem;
    font: 400 clamp(1.6rem, 3vw, 2.5rem)/1 var(--font-serif);
  }
  .pwy-chapter-card h3 a {
    color: var(--fg);
    text-decoration: none;
  }
  .pwy-chapter-card h3 a:hover,
  .pwy-chapter-card h3 a:focus-visible {
    color: var(--accent);
  }
  .pwy-chapter-card p {
    margin: 0;
    color: var(--fg-muted);
    font-size: 0.92rem;
  }
  .pwy-chapter-card__locality {
    color: var(--fg-faint);
    font: 0.72rem/1.3 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .pwy-chapter-card__link {
    display: inline-flex;
    gap: 0.6rem;
    margin-top: auto;
    padding-top: 1.5rem;
    color: var(--fg);
    font-size: 0.88rem;
    font-weight: 650;
  }
  .pwy-chapter-card__link:hover,
  .pwy-chapter-card__link:focus-visible {
    color: var(--accent);
  }
  .pwy-chapter-principles {
    display: grid;
    grid-template-columns: minmax(14rem, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 10vw, 10rem);
    padding: clamp(3.5rem, 8vw, 6.5rem) 0;
  }
  .pwy-prose p {
    margin: 0 0 1.25rem;
    color: var(--fg-muted);
    font-size: 1.05rem;
  }
  .pwy-prose p:last-child {
    margin-bottom: 0;
  }
  .pwy-page-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 2rem 0 4rem;
    border-top: 1px solid var(--line);
  }
  .pwy-page-footer p {
    margin: 0;
    color: var(--fg-muted);
  }
  .pwy-button {
    display: inline-flex;
    gap: 0.8rem;
    align-items: center;
    padding: 0.85rem 1.1rem;
    background: var(--accent);
    color: #fff;
    text-decoration: none;
    font-weight: 650;
  }
  .pwy-button:hover,
  .pwy-button:focus-visible {
    background: var(--accent-secondary);
    color: #fff;
  }
  @media (max-width: 48rem) {
    .pwy-chapter-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .pwy-hero__grid,
    .pwy-chapter-principles {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .pwy-chapter-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
