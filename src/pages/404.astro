---
import Base from "@layouts/Base.astro";

export const prerender = false;
---

<Base
  title="Not found — The Social Club"
  description="That page is not on the schedule."
  canonicalPath="/"
>
  <section class="section">
    <div class="container">
      <h1>Not on the schedule</h1>
      <p>
        That page has been — perhaps generously — cancelled. Try the
        <a href="/">homepage</a> or
        <a href="/waiting-list/">join the waiting list</a>.
      </p>
    </div>
  </section>
</Base>
