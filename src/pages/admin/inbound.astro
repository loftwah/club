---
import { runtimeEnv } from "@lib/runtime-env";
import Base from "@layouts/Base.astro";
import "../../styles/app-surfaces.css";

interface InboundRow {
  id: string;
  from_address: string | null;
  subject: string | null;
  state: string;
  received_at: string;
  human_review_required: number;
}

const env = runtimeEnv;
const rows: InboundRow[] = env?.DB
  ? await env.DB.prepare(
      `SELECT id, from_address, subject, state, received_at, human_review_required
           FROM inbound_messages
           ORDER BY received_at DESC LIMIT 100`,
    )
      .all<InboundRow>()
      .then((r) => (r.results ?? []) as InboundRow[])
  : [];
---

<Base title="Inbound — Admin" description="Inbound email review" canonicalPath="/admin/inbound/">
  <section class="section app-surface app-operator">
    <div class="container">
      <header class="app-page-head">
        <div class="app-page-head__main">
          <p class="app-breadcrumb"><a href="/admin/">Operator desk</a> / Inbound</p>
          <p class="app-kicker">Correspondence review</p>
          <h1>Inbound email</h1>
          <p class="app-lede">
            Recent inbound messages and their review state. Use the bounded operator tools to filter
            or act on a scoped queue.
          </p>
        </div>
        <dl class="app-page-head__aside">
          <dt>Rows shown</dt><dd>{rows.length}</dd><dt>Sort</dt><dd>Newest received first</dd>
        </dl>
      </header>
      <section class="app-section" aria-labelledby="inbound-heading">
        <div class="app-section__head">
          <h2 id="inbound-heading">Recent messages</h2><p>Operator review</p>
        </div>
        {
          rows.length === 0 ? (
            <p class="app-empty">
              <>
                <strong>No inbound messages</strong>
                <span>The correspondence review queue is clear.</span>
              </>
            </p>
          ) : (
            <div class="app-table-wrap">
              <table class="admin-table app-table app-table--cards">
                <>
                  <thead>
                    <tr>
                      <>
                        <th>State</th>
                        <th>From</th>
                        <th>Subject</th>
                        <th>Received</th>
                        <th>Review</th>
                      </>
                    </tr>
                  </thead>
                  <tbody>
                    {rows.map((r) => (
                      <tr>
                        <td data-label="State">
                          <span
                            class={`pill ${r.state === "HUMAN_REVIEW" ? "pill--warn" : "pill--info"}`}
                          >
                            {r.state}
                          </span>
                        </td>
                        <td data-label="From">{r.from_address ?? "—"}</td>
                        <td data-label="Subject">{r.subject ?? "—"}</td>
                        <td data-label="Received">{r.received_at}</td>
                        <td data-label="Review">{r.human_review_required ? "yes" : "no"}</td>
                      </tr>
                    ))}
                  </tbody>
                </>
              </table>
            </div>
          )
        }
      </section>
    </div>
  </section>
</Base>
