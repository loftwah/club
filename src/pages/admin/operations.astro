---
import Base from "@layouts/Base.astro";
import { dailyOperations } from "../../lib/admin-data";
const ops = await dailyOperations(Astro.locals?.runtime?.env);
---

<Base title="Operations — Admin" description="Operator digest" canonicalPath="/admin/operations/">
  <section class="section">
    <div class="container">
      <p><a href="/admin/">← Back to admin</a></p>
      <h1>Operations digest</h1>
      <p>Same data as the MCP <code>club.get_daily_operations</code> tool.</p>

      <h2>Counts</h2>
      <table class="admin-table">
        <thead>
          <tr>
            <th>Metric</th>
            <th>Value</th>
          </tr>
        </thead>
        <tbody>
          <tr><td>Dangerous uncancelled events</td><td>{ops.dangerousEvents}</td></tr>
          <tr><td>Retried emails</td><td>{ops.retriedEmails}</td></tr>
          <tr><td>Overdue fulfilments</td><td>{ops.overdueFulfilments}</td></tr>
          <tr><td>Dead-letter jobs</td><td>{ops.deadLetters}</td></tr>
          <tr><td>Inbound messages requiring review</td><td>{ops.inboundReview}</td></tr>
        </tbody>
      </table>

      <h2>Tasks requiring attention</h2>
      {
        ops.todayCount === 0 ? (
          <p style="color: var(--success)">
            <strong>No intervention required.</strong>
          </p>
        ) : (
          <table class="admin-table">
            <thead>
              <tr>
                <th>Urgency</th>
                <th>Label</th>
                <th>Detail</th>
              </tr>
            </thead>
            <tbody>
              {ops.today.map((t) => (
                <tr>
                  <td>
                    <span class={`pill pill--${t.urgency}`}>{t.urgency}</span>
                  </td>
                  <td>{t.label}</td>
                  <td>{t.detail}</td>
                </tr>
              ))}
            </tbody>
          </table>
        )
      }
    </div>
  </section>
</Base>
