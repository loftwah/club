---
import { runtimeEnv } from "@lib/runtime-env";
import Base from "@layouts/Base.astro";
import "../../styles/app-surfaces.css";

interface FulfilmentTaskRow {
  id: string;
  member_id: string;
  task_type: string;
  state: string;
  deadline: string | null;
  created_at: string;
}

const env = runtimeEnv;
const tasks: FulfilmentTaskRow[] = env?.DB
  ? await env.DB.prepare(
      `SELECT id, member_id, task_type, state, deadline, created_at
           FROM fulfilment_tasks
           WHERE state NOT IN ('COMPLETED', 'CANCELLED')
           ORDER BY (deadline IS NULL), deadline ASC, created_at ASC
           LIMIT 100`,
    )
      .all<FulfilmentTaskRow>()
      .then((r) => (r.results ?? []) as FulfilmentTaskRow[])
  : [];
---

<Base title="Tasks — Admin" description="Fulfilment tasks" canonicalPath="/admin/tasks/">
  <section class="section app-surface app-operator">
    <div class="container">
      <header class="app-page-head">
        <div class="app-page-head__main">
          <p class="app-breadcrumb"><a href="/admin/">Operator desk</a> / Tasks</p>
          <p class="app-kicker">Human fulfilment queue</p>
          <h1>Fulfilment tasks</h1>
          <p class="app-lede">
            Open work is ordered by deadline first, then creation date. Every task should complete,
            cancel, retry, or escalate explicitly.
          </p>
        </div>
        <dl class="app-page-head__aside">
          <dt>Open rows</dt><dd>{tasks.length}</dd><dt>Order</dt><dd>Deadline, then created</dd>
        </dl>
      </header>
      <section class="app-section" aria-labelledby="queue-heading">
        <div class="app-section__head">
          <h2 id="queue-heading">Open queue</h2><p>Terminal-state discipline</p>
        </div>
        {
          tasks.length === 0 ? (
            <p class="app-empty">
              <>
                <strong>No open tasks</strong>
                <span>There is nothing to fulfil, retry, or escalate right now.</span>
              </>
            </p>
          ) : (
            <div class="app-table-wrap">
              <table class="admin-table app-table app-table--cards">
                <>
                  <thead>
                    <tr>
                      <>
                        <th>State</th>
                        <th>Type</th>
                        <th>Member</th>
                        <th>Deadline</th>
                        <th>Created</th>
                      </>
                    </tr>
                  </thead>
                  <tbody>
                    {tasks.map((t) => (
                      <tr>
                        <td data-label="State">
                          <span
                            class={`pill ${t.state === "OVERDUE" || t.state === "ESCALATED" ? "pill--danger" : "pill--info"}`}
                          >
                            {t.state}
                          </span>
                        </td>
                        <td data-label="Type">{t.task_type}</td>
                        <td data-label="Member">
                          <code>{t.member_id}</code>
                        </td>
                        <td data-label="Deadline">{t.deadline ?? "—"}</td>
                        <td data-label="Created">{t.created_at}</td>
                      </tr>
                    ))}
                  </tbody>
                </>
              </table>
            </div>
          )
        }
      </section>
    </div>
  </section>
</Base>
