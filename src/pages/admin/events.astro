---
import Base from "@layouts/Base.astro";

interface EventRow {
  id: string;
  title: string;
  state: string;
  start_at: string;
  cancellation_due_at: string;
  chapter_id: string;
}

const env = Astro.locals?.runtime?.env;
const events: EventRow[] = env?.DB
  ? await env.DB.prepare(
      `SELECT id, title, state, start_at, cancellation_due_at, chapter_id
           FROM events
           ORDER BY start_at DESC LIMIT 100`,
    )
      .all<EventRow>()
      .then((r) => (r.results ?? []) as EventRow[])
  : [];
---

<Base title="Events — Admin" description="Event catalogue" canonicalPath="/admin/events/">
  <section class="section">
    <div class="container">
      <p><a href="/admin/">← Back to admin</a></p>
      <h1>Events</h1>
      <p>
        Every event in D1. Ordinary events only; the forbidden attendance states (ATTENDED /
        CHECKED_IN / NO_SHOW) are not stored.
      </p>
      {
        events.length === 0 ? (
          <p style="color: var(--fg-muted)">No events yet.</p>
        ) : (
          <table class="admin-table">
            <thead>
              <tr>
                <th>State</th>
                <th>Title</th>
                <th>Chapter</th>
                <th>Start</th>
                <th>Cancellation due</th>
              </tr>
            </thead>
            <tbody>
              {events.map((e) => (
                <tr>
                  <td>
                    <span
                      class={`pill ${e.state === "CANCELLED" || e.state === "ARCHIVED" ? "pill--ok" : e.state.includes("FAILURE") || e.state.includes("CRITICAL") ? "pill--danger" : "pill--info"}`}
                    >
                      {e.state}
                    </span>
                  </td>
                  <td>{e.title}</td>
                  <td>{e.chapter_id}</td>
                  <td>{e.start_at}</td>
                  <td>{e.cancellation_due_at}</td>
                </tr>
              ))}
            </tbody>
          </table>
        )
      }
    </div>
  </section>
</Base>
