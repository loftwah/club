---
import { runtimeEnv } from "@lib/runtime-env";
import Base from "@layouts/Base.astro";
import "../../styles/app-surfaces.css";

interface EventRow {
  id: string;
  title: string;
  state: string;
  start_at: string;
  cancellation_due_at: string;
  chapter_id: string;
}

const env = runtimeEnv;
const events: EventRow[] = env?.DB
  ? await env.DB.prepare(
      `SELECT id, title, state, start_at, cancellation_due_at, chapter_id
           FROM events
           ORDER BY start_at DESC LIMIT 100`,
    )
      .all<EventRow>()
      .then((r) => (r.results ?? []) as EventRow[])
  : [];
---

<Base title="Events — Admin" description="Event catalogue" canonicalPath="/admin/events/">
  <section class="section app-surface app-operator">
    <div class="container">
      <header class="app-page-head">
        <div class="app-page-head__main">
          <p class="app-breadcrumb"><a href="/admin/">Operator desk</a> / Events</p>
          <p class="app-kicker">Schedule state catalogue</p>
          <h1>Events</h1>
          <p class="app-lede">
            Every event in D1 is shown with its current state and cancellation deadline. Ordinary
            plans end in cancellation; they do not create an attendance workflow.
          </p>
        </div>
        <dl class="app-page-head__aside">
          <dt>Rows shown</dt><dd>{events.length}</dd><dt>Safety rule</dt><dd>
            Cancellation is successful fulfilment
          </dd>
        </dl>
      </header>
      <section class="app-section" aria-labelledby="events-heading">
        <div class="app-section__head">
          <h2 id="events-heading">Schedule records</h2><p>Newest start first</p>
        </div>
        {
          events.length === 0 ? (
            <p class="app-empty">
              <>
                <strong>No event records yet</strong>
                <span>There are no plans in the operator catalogue.</span>
              </>
            </p>
          ) : (
            <div class="app-table-wrap">
              <table class="admin-table app-table app-table--cards">
                <>
                  <thead>
                    <tr>
                      <>
                        <th>State</th>
                        <th>Title</th>
                        <th>Chapter</th>
                        <th>Start</th>
                        <th>Cancellation due</th>
                      </>
                    </tr>
                  </thead>
                  <tbody>
                    {events.map((e) => (
                      <tr>
                        <td data-label="State">
                          <span
                            class={`pill ${e.state === "CANCELLED" || e.state === "ARCHIVED" ? "pill--ok" : e.state.includes("FAILURE") || e.state.includes("CRITICAL") ? "pill--danger" : "pill--info"}`}
                          >
                            {e.state}
                          </span>
                        </td>
                        <td data-label="Title">{e.title}</td>
                        <td data-label="Chapter">
                          <code>{e.chapter_id}</code>
                        </td>
                        <td data-label="Start">{e.start_at}</td>
                        <td data-label="Cancellation due">{e.cancellation_due_at}</td>
                      </tr>
                    ))}
                  </tbody>
                </>
              </table>
            </div>
          )
        }
      </section>
    </div>
  </section>
</Base>
