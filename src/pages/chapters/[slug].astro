---
import Base from "@layouts/Base.astro";
import { formatLocality, formatInZone } from "@lib/geography";
import { getChapter, listChapters, type Chapter } from "@lib/chapters";

// Issue #12: the chapter catalogue is the single source of
// truth (src/lib/chapters.ts). This page derives both the
// detail rendering AND the static slug list for the
// getStaticPaths/equivalent build from the same function.
const slug = Astro.params.slug ?? "";
const chapter: Chapter | null =
  getChapter(slug) ?? listChapters().find((c) => c.slug === slug) ?? null;

if (!chapter) {
  return Astro.redirect("/chapters/");
}
const chapterLocality = formatLocality(chapter);
const sampleTimestamp = "2026-09-15T08:00:00.000Z";
const sampleLocal = chapter.timezone
  ? formatInZone(sampleTimestamp, chapter.timezone, chapter.locale)
  : sampleTimestamp;
---

<Base
  title={`${chapter.name} — Chapters`}
  description={`${chapter.name} chapter. ${chapter.note}`}
  canonicalPath={`/chapters/${slug}/`}
>
  <section class="pwy-page pwy-chapter" aria-labelledby="chapter-heading">
    <div class="pwy-shell">
      <p class="pwy-breadcrumb"><a href="/chapters/">← All chapters</a></p>
      <header class="pwy-hero">
        <p class="pwy-kicker">
          Chapter / {chapter.status === "ACTIVE" ? "accepting waitlist" : "forming"}
        </p>
        <div class="pwy-hero__grid">
          <div>
            <p
              class="pwy-status"
              aria-label={`Chapter status: ${chapter.status === "ACTIVE" ? "accepting waitlist" : "forming"}`}
            >
              {chapter.status === "ACTIVE" ? "Accepting waitlist" : "Forming"}
            </p>
            <h1 id="chapter-heading">{chapter.name}</h1>
            <p class="pwy-chapter__locality">{chapterLocality}</p>
          </div>
          <p class="pwy-hero__lede">{chapter.note}</p>
          <p class="pwy-chapter__timezone">
            Local time preview: <span>{sampleLocal}</span> ({chapter.timezone})
          </p>
        </div>
        <div class="pwy-hero__meta">
          <span>Paid membership closed</span>
          <span>Waitlist interest is free</span>
        </div>
      </header>

      <section class="pwy-chapter-detail" aria-labelledby="detail-heading">
        <div>
          <p class="pwy-kicker">What this means</p>
          <h2 id="detail-heading">A location in the register, not a promise of a venue.</h2>
        </div>
        <div class="pwy-prose">
          <p>
            Joining the {chapter.name} waitlist tells us you are interested. It does not start paid membership,
            reserve a place at an event or create a partnership.
          </p>
          <p>
            When this chapter is ready, its correspondence will draw on real people, places and
            local knowledge. Ordinary plans will still be made and deliberately cancelled; nobody is
            expected to attend them.
          </p>
        </div>
      </section>

      <section class="pwy-chapter-next" aria-labelledby="next-heading">
        <p class="pwy-kicker">Next notice</p>
        <h2 id="next-heading">Keep your place in the conversation.</h2>
        <p>Join the free waitlist and include {chapter.name} as your chapter of interest.</p>
        <a class="pwy-button" href={`/waiting-list/?chapter=${slug}`}
          >Join the {chapter.name} waitlist <span aria-hidden="true">↗</span></a
        >
      </section>
    </div>
  </section>
</Base>

<style>
  .pwy-page {
    color: var(--fg);
  }
  .pwy-breadcrumb {
    margin: 1.25rem 0 0;
    font-size: 0.9rem;
  }
  .pwy-breadcrumb a {
    color: var(--fg-muted);
  }
  .pwy-hero {
    padding: clamp(3.5rem, 9vw, 7rem) 0 clamp(2.5rem, 6vw, 4.5rem);
    border-bottom: 1px solid var(--line);
  }
  .pwy-kicker {
    margin: 0 0 1rem;
    color: var(--fg-faint);
    font: 600 0.72rem/1.2 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .pwy-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(16rem, 0.9fr);
    gap: clamp(2rem, 8vw, 9rem);
    align-items: end;
  }
  .pwy-status {
    display: inline-block;
    margin: 0 0 1.25rem;
    color: var(--accent);
    font: 600 0.72rem/1.2 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .pwy-hero h1 {
    margin: 0;
    /* Canonical Dispatch Wall display grammar; cap from
       public-pages.css (5.8rem) is the max for ordinary public
       routes. The chapter detail heading was previously 11rem
       (nearly 2× the cap) — brought into the canonical grammar. */
    font-size: clamp(2.6rem, 6vw, 5.8rem);
    line-height: 0.95;
    font-weight: 680;
  }
  .pwy-hero__lede {
    max-width: 38rem;
    margin: 0;
    color: var(--fg-muted);
    font-size: clamp(1.1rem, 1.8vw, 1.45rem);
    line-height: 1.35;
  }
  .pwy-chapter__locality,
  .pwy-chapter__timezone {
    margin: 0.4rem 0 0;
    color: var(--fg-faint);
    font: 0.72rem/1.4 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .pwy-chapter__timezone span {
    color: var(--ink);
  }
  .pwy-hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.4rem;
    margin-top: 2.5rem;
    color: var(--fg-faint);
    font: 0.72rem/1.2 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .pwy-chapter-detail {
    display: grid;
    grid-template-columns: minmax(14rem, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 10vw, 10rem);
    padding: clamp(3.5rem, 8vw, 6.5rem) 0;
    border-bottom: 1px solid var(--line);
  }
  .pwy-chapter-detail h2,
  .pwy-chapter-next h2 {
    margin: 0;
    font: 400 clamp(2rem, 4vw, 3.5rem)/0.98 var(--font-serif);
    letter-spacing: -0.035em;
  }
  .pwy-prose {
    max-width: 42rem;
  }
  .pwy-prose p {
    margin: 0 0 1.25rem;
    color: var(--fg-muted);
    font-size: 1.05rem;
  }
  .pwy-prose p:last-child {
    margin-bottom: 0;
  }
  .pwy-chapter-next {
    padding: clamp(3.5rem, 8vw, 6.5rem) 0 5rem;
  }
  .pwy-chapter-next > p:not(.pwy-kicker) {
    max-width: 34rem;
    margin: 1rem 0 1.5rem;
    color: var(--fg-muted);
    font-size: 1.1rem;
  }
  .pwy-button {
    display: inline-flex;
    gap: 0.8rem;
    align-items: center;
    padding: 0.85rem 1.1rem;
    background: var(--accent);
    color: #fff;
    text-decoration: none;
    font-weight: 650;
  }
  .pwy-button:hover,
  .pwy-button:focus-visible {
    background: var(--accent-secondary);
    color: #fff;
  }
  @media (max-width: 48rem) {
    .pwy-hero__grid,
    .pwy-chapter-detail {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
