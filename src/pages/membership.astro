---
import Base from "@layouts/Base.astro";
---

<Base
  title="Membership — The Social Club"
  description="Three tiers: A$5, A$20, A$50. The same belonging, different physical and human intensity."
  canonicalPath="/membership/"
>
  <section class="section">
    <div class="container">
      <h1>Membership</h1>
      <p>
        All members are equal in belonging. Tiers differ in physical intensity and human time, not
        in emotional worth.
      </p>
      <div class="tiers">
        <article class="tier">
          <h3>Core — A$5/month</h3>
          <ul>
            <li>Member identity and number</li>
            <li>Invitations and cancellations</li>
            <li>Personalised digital correspondence</li>
            <li>Birthday and anniversary recognition</li>
            <li>Member memory</li>
          </ul>
        </article>
        <article class="tier">
          <h3>Physical correspondence — A$20/month</h3>
          <ul>
            <li>Welcome pack and physical card</li>
            <li>Posted birthday card</li>
            <li>Signed correspondence</li>
            <li>Milestone artefacts</li>
            <li>Optional manufactured commitments</li>
          </ul>
        </article>
        <article class="tier">
          <h3>Deluxe human — A$50/month</h3>
          <ul>
            <li>All of the above</li>
            <li>Hand-signed personal letters</li>
            <li>Thoughtful gifts</li>
            <li>Opted-in calls</li>
            <li>Priority handling</li>
          </ul>
        </article>
      </div>
      <p>
        <a href="/waiting-list/" class="hero__cta">Join the waiting list</a>
      </p>
    </div>
  </section>
</Base>
