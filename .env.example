# Cloudflare account ID — already known
CF_ACCOUNT_ID=1003dc1d93af0ebea56b2f1252f89627

# Cloudflare API token
# Cloudflare → My Profile → API Tokens → Create Token
CF_API_TOKEN=

# R2 S3 Access Key ID — already known
CF_ACCESS_KEY_ID=b6246d06e44d825f8558f7e41036432e

# R2 Secret Access Key
# This was shown ONCE when you created the R2 API token.
# If you didn't save it, create a new R2 API token.
CF_SECRET_ACCESS_KEY=

# R2 S3 endpoint — already correct
CF_S3_API_ENDPOINT=https://1003dc1d93af0ebea56b2f1252f89627.r2.cloudflarestorage.com

# Your existing Resend Full Access API key: re_...
RESEND_API_KEY=

# Resend → Webhooks → Add Webhook
# URL: https://club.loftwah.com/api/webhooks/resend
# Subscribe initially to: email.received
# Resend then gives you: whsec_...
RESEND_WEBHOOK_ID=
RESEND_WEBHOOK_SIGNING_SECRET=

# Your existing MiniMax API key.
# Use the same environment value you're already using with MiniMax tooling.
MINIMAX_API_KEY=

# Fixed — this is the domain we've chosen
APP_BASE_URL=https://club.loftwah.com

# Your already-verified Resend FROM address
# Example format: The Club <clubname@loftwah.com>
RESEND_FROM=

# Your own email address — where the system sends YOU jobs,
# alerts, letters to print/sign, calls to make, gifts to organise, etc.
OPERATOR_EMAIL=